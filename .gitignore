# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Sensitive / Local Configuration
config.env
.env
*.creds

# Media Archives & High-Res Content (Preserve directory structure via .gitkeep)
