# ---------------------------------------------------------------------------
# Main interactive flow: create a new command
# ---------------------------------------------------------------------------
create_command() {
    echo ""
    echo -e "${BOLD}${CYAN}  ── Create New KDE Connect Command ──${RESET}"
    echo ""

    # 1. Command name
    local cmd_name=""
    while [[ -z "${cmd_name}" ]]; do
        read -rp "  $(echo -e "${BOLD}Command Name${RESET} (label shown in KDE Connect app): ")" cmd_name
        cmd_name="$(echo "${cmd_name}" | xargs)"
        [[ -z "${cmd_name}" ]] && echo -e "  ${RED}Command name cannot be empty.${RESET}"
    done

    echo ""

    # 2. Script path
    local script_path=""
    while true; do
        read -rp "  $(echo -e "${BOLD}Full Path to Bash Script${RESET}: ")" script_path
        # Expand ~ if present
        script_path="${script_path/#\~/$HOME}"
        if [[ -z "${script_path}" ]]; then
            echo -e "  ${RED}Script path cannot be empty.${RESET}"
            continue
        fi
        if [[ ! -f "${script_path}" ]]; then
            echo -e "  ${YELLOW}⚠  Warning:${RESET} File '${script_path}' not found on disk."
            read -rp "  Register it anyway? [y/N]: " anyway
            [[ "${anyway,,}" == "y" ]] && break
            continue
        fi
        if [[ ! -x "${script_path}" ]]; then
            echo -e "  ${YELLOW}⚠  Script is not executable. Making it executable now…${RESET}"
            chmod +x "${script_path}" && echo -e "  ${GREEN}Done.${RESET}"
        fi
        break
    done

    echo ""

    # 3. Summary
    local summary=""
    while [[ -z "${summary}" ]]; do
        read -rp "  $(echo -e "${BOLD}Brief Summary${RESET} of what this command does: ")" summary
        summary="$(echo "${summary}" | xargs)"
        [[ -z "${summary}" ]] && echo -e "  ${RED}Summary cannot be empty.${RESET}"
    done

    echo ""

    # 4. Pick target device
    local plugin_dir
    plugin_dir=$(pick_device_config_dir) || { press_enter; return 1; }

    local qdbus_bin=""
    if command -v qdbus6 &>/dev/null; then
        qdbus_bin="qdbus6"
    elif command -v qdbus &>/dev/null; then
        qdbus_bin="qdbus"
    fi

    local -a target_plugin_dirs=()
    local -a target_dev_names=()
    local -a target_dev_ids=()

    if [[ "${plugin_dir}" == "ALL" ]]; then
        while IFS= read -r pdir; do
            [[ -n "${pdir}" ]] || continue
            target_plugin_dirs+=("${pdir}")
            local did="$(basename "$(dirname "${pdir}")")"
            target_dev_ids+=("${did}")
            local dname="${did}"
            local dcfg="$(dirname "${pdir}")/config"
            if [[ -f "${dcfg}" ]]; then
                dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
            fi
            target_dev_names+=("${dname}")
        done < <(get_all_paired_device_plugin_dirs)
    else
        target_plugin_dirs+=("${plugin_dir}")
        local did="$(basename "$(dirname "${plugin_dir}")")"
        target_dev_ids+=("${did}")
        local dname="${did}"
        local dcfg="$(dirname "${plugin_dir}")/config"
        if [[ -f "${dcfg}" ]]; then
            dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
        fi
        target_dev_names+=("${dname}")
    fi

    local last_cfg=""
    for (( ti=0; ti<${#target_plugin_dirs[@]}; ti++ )); do
        local t_pdir="${target_plugin_dirs[$ti]}"
        local t_dname="${target_dev_names[$ti]}"
        local t_did="${target_dev_ids[$ti]}"
        mkdir -p "${t_pdir}"
        local t_cfg="${t_pdir}/config"
        last_cfg="${t_cfg}"
        local t_key
        t_key=$(next_command_key "${t_cfg}") || true
        [[ -z "${t_key}" ]] && t_key="cmd0"
        echo ""
        echo -e "  ${DIM}Writing command '${cmd_name}' → ${t_cfg}${RESET}"
        write_command_to_config "${t_cfg}" "${t_key}" "${cmd_name}" "${script_path}"
        if declare -F log_entry &>/dev/null; then
            log_entry "CREATED command '${cmd_name}' | script='${script_path}' | device='${t_dname}' | key='${t_key}'" || true
        fi
        if [[ -n "${qdbus_bin}" && -n "${t_did}" ]]; then
            "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${t_did}/runcommand" \
                org.kde.kdeconnect.device.runcommand.reload &>/dev/null || true
            "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${t_did}" \
                org.kde.kdeconnect.device.reloadPlugins &>/dev/null || true
        fi
    done

    # 6. Update manual
    if declare -F update_manual &>/dev/null; then
        update_manual "${cmd_name}" "${script_path}" "${summary}" || true
    fi

    if [[ -n "${qdbus_bin}" ]]; then
        "${qdbus_bin}" org.kde.kdeconnect /modules/kdeconnect \
            org.kde.kdeconnect.daemon.forceOnNetworkChange &>/dev/null || true
    fi

    local disp_device
    if [[ "${plugin_dir}" == "ALL" ]]; then
        disp_device="All Paired Devices (${#target_plugin_dirs[@]})"
    else
        disp_device="${target_dev_names[0]}"
    fi

    # 9. Display post-install summary
    show_summary "${cmd_name}" "${script_path}" "${summary}" \
                 "${disp_device}" "${last_cfg}"
}

# ---------------------------------------------------------------------------
# Collect all installed commands into indexed arrays (across all devices)
# Populates globals: CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
# ---------------------------------------------------------------------------
collect_all_commands() {
    CMD_KEYS=()
    CMD_NAMES=()
    CMD_SCRIPTS=()
    CMD_DEVICES=()
    CMD_CFGS=()

    while IFS=$'\t' read -r _k _n _s _d _c; do
        [[ -z "${_n}" ]] && continue
        CMD_KEYS+=("${_k}")
        CMD_NAMES+=("${_n}")
        CMD_SCRIPTS+=("${_s}")
        CMD_DEVICES+=("${_d}")
        CMD_CFGS+=("${_c}")
    done < <(python3 - "${KDECONNECT_CFG_DIR}" <<'PYEOF'
import sys, os, glob, re, json
kdir = sys.argv[1]
rows = []
for cfg in sorted(glob.glob(f"{kdir}/*/kdeconnect_runcommand/config")):
    pdir = os.path.dirname(cfg)
    ddir = os.path.dirname(pdir)
    dcfg = os.path.join(ddir, "config")
    dname = os.path.basename(ddir)
    if os.path.isfile(dcfg):
        try:
            with open(dcfg, "r", encoding="utf-8", errors="ignore") as df:
                for line in df:
                    if line.startswith("name="):
                        v = line.split("=", 1)[1].strip()
                        if v: dname = v; break
        except Exception:
            pass

    dev_cmds = {}
    try:
        with open(cfg, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()
        for line in lines:
            line = line.strip()
            if line.startswith("commands="):
                raw = line[len("commands="):].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if raw.startswith("@ByteArray(") and raw.endswith(")"):
                    raw = raw[len("@ByteArray("):-1].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if r'\"' in raw:
                    raw = raw.replace(r'\"', '"')
                try:
                    data = json.loads(raw)
                    if isinstance(data, str): data = json.loads(data)
                    if isinstance(data, dict):
                        for u, entry in data.items():
                            if isinstance(entry, dict):
                                c_name = entry.get("name", "").strip()
                                c_cmd = entry.get("command", "").strip()
                                if c_name and c_cmd: dev_cmds[c_name] = (u, c_cmd)
                except Exception:
                    pass
                break

        in_commands = False
        ini_names = {}; ini_cmds = {}
        for line in lines:
            line = line.strip()
            if line == "[commands]": in_commands = True; continue
            if in_commands and line.startswith("["): in_commands = False; continue
            if in_commands and "=" in line:
                k, v = line.split("=", 1)
                k = k.strip(); v = v.strip()
                m_name = re.match(r'^(cmd[0-9]+)\\name$', k)
                m_cmd = re.match(r'^(cmd[0-9]+)\\command$', k)
                if m_name: ini_names[m_name.group(1)] = v
                elif m_cmd: ini_cmds[m_cmd.group(1)] = v

        for k, c_name in ini_names.items():
            if c_name not in dev_cmds and k in ini_cmds:
                dev_cmds[c_name] = (k, ini_cmds[k])

        for c_name, (c_key, c_script) in sorted(dev_cmds.items()):
            rows.append((c_key, c_name, c_script, dname, cfg))
    except Exception:
        pass

for r in rows:
    clean = [str(x).replace('\t', ' ').replace('\n', ' ') for x in r]
    print('\t'.join(clean))
PYEOF
)
}

# ---------------------------------------------------------------------------
# Look up a command's summary from Congen_Commands_List.txt by name
# ---------------------------------------------------------------------------
lookup_summary_from_manual() {
    local target_name="$1"
    [[ ! -f "${MANUAL_FILE}" ]] && echo "—" && return

    # The manual uses "  Command Name : <name>" followed by "  Summary      : <text>"
    python3 - "${MANUAL_FILE}" "${target_name}" <<'PYEOF'
import sys, re

manual_path = sys.argv[1]
target      = sys.argv[2].strip()

with open(manual_path, 'r', errors='replace') as f:
    content = f.read()

# Split into blocks separated by the ─── dividers
blocks = re.split(r'─{10,}', content)
summary = '—'
for block in blocks:
    name_m = re.search(r'Command Name\s*:\s*(.+)', block)
    summ_m = re.search(r'Summary\s*:\s*(.+)', block)
    if name_m and name_m.group(1).strip() == target and summ_m:
        summary = summ_m.group(1).strip()
        break
print(summary)
PYEOF
}

# ---------------------------------------------------------------------------
# Look up the "Added" date from the manual for a given command name
# ---------------------------------------------------------------------------
lookup_added_from_manual() {
    local target_name="$1"
    [[ ! -f "${MANUAL_FILE}" ]] && echo "—" && return

    python3 - "${MANUAL_FILE}" "${target_name}" <<'PYEOF'
import sys, re

manual_path = sys.argv[1]
target      = sys.argv[2].strip()

with open(manual_path, 'r', errors='replace') as f:
    content = f.read()

blocks = re.split(r'─{10,}', content)
added = '—'
for block in blocks:
    name_m  = re.search(r'Command Name\s*:\s*(.+)', block)
    added_m = re.search(r'Added\s*:\s*(.+)', block)
    if name_m and name_m.group(1).strip() == target and added_m:
        added = added_m.group(1).strip()
        break
print(added)
PYEOF
}

# ---------------------------------------------------------------------------
# Remove a single command entry from the plugin config INI
# ---------------------------------------------------------------------------
remove_command_from_config() {
    local cfg="$1"
    local key="$2"   # e.g. "cmd0" or UUID
    local name="${3:-}"
    local script="${4:-}"

    python3 - "${cfg}" "${key}" "${name}" "${script}" <<'PYEOF'
import sys, os, re, json

cfg_path = sys.argv[1]
key      = sys.argv[2]
name     = sys.argv[3] if len(sys.argv) > 3 else ""
script   = sys.argv[4] if len(sys.argv) > 4 else ""

if not os.path.isfile(cfg_path):
    sys.exit(0)

with open(cfg_path, 'r', encoding='utf-8', errors='ignore') as f:
    lines = f.readlines()

# 1. Update @ByteArray in lines
for idx, line in enumerate(lines):
    l_strip = line.strip()
    if l_strip.startswith("commands="):
        raw = l_strip[len("commands="):].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if raw.startswith("@ByteArray(") and raw.endswith(")"):
            raw = raw[len("@ByteArray("):-1].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if r'\"' in raw:
            raw = raw.replace(r'\"', '"')
        try:
            data = json.loads(raw)
            if isinstance(data, str): data = json.loads(data)
            if isinstance(data, dict):
                to_delete = []
                for u, entry in data.items():
                    if u == key:
                        to_delete.append(u)
                    elif isinstance(entry, dict):
                        if (name and entry.get("name") == name) or (script and entry.get("command") == script):
                            to_delete.append(u)
                for u in to_delete:
                    del data[u]
                compact_json = json.dumps(data, separators=(',', ':'))
                escaped_json = compact_json.replace('"', '\\"')
                lines[idx] = f'commands="@ByteArray({escaped_json})"\n'
        except Exception:
            pass
        break

# 2. Update legacy [commands] section
new_lines = []
in_commands = False
for line in lines:
    l_strip = line.strip()
    if l_strip == "[commands]":
        in_commands = True
        new_lines.append(line)
        continue
    if in_commands and l_strip.startswith("["):
        in_commands = False
    if in_commands:
        if key and (l_strip.startswith(f"{key}\\name=") or l_strip.startswith(f"{key}\\command=")):
            continue
        if name and re.match(rf'^cmd[0-9]+\\name={re.escape(name)}$', l_strip):
            continue
        if script and re.match(rf'^cmd[0-9]+\\command={re.escape(script)}$', l_strip):
            continue
    new_lines.append(line)

with open(cfg_path, 'w', encoding='utf-8') as f:
    f.writelines(new_lines)
PYEOF
}

# ---------------------------------------------------------------------------
# Remove a command entry from Congen_Commands_List.txt by name
# ---------------------------------------------------------------------------
remove_from_manual() {
    local target_name="$1"
    [[ ! -f "${MANUAL_FILE}" ]] && return

    python3 - "${MANUAL_FILE}" "${target_name}" <<'PYEOF'
import sys, re

manual_path = sys.argv[1]
target      = sys.argv[2].strip()

with open(manual_path, 'r', errors='replace') as f:
    content = f.read()

# Split on dividers, filter out matching blocks, reassemble
divider = '─' * 80
parts   = content.split(divider)
kept    = []
for part in parts:
    m = re.search(r'Command Name\s*:\s*(.+)', part)
    if m and m.group(1).strip() == target:
        continue   # drop this block
    kept.append(part)

with open(manual_path, 'w') as f:
    f.write(divider.join(kept))
PYEOF
}

# ---------------------------------------------------------------------------
# View Installed KDE Connect Commands — submenu
# ---------------------------------------------------------------------------
view_installed_commands() {
    while true; do
        clear
        echo ""
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}View Installed KDE Connect Commands${RESET}"
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo ""

        # ── Collect live data ──────────────────────────────────────────────
        declare -a CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        collect_all_commands

        local total="${#CMD_KEYS[@]}"

        if [[ ${total} -eq 0 ]]; then
            echo -e "  ${YELLOW}No KDE Connect run-commands are currently installed.${RESET}"
            echo -e "  ${DIM}Use option 1 from the main menu to create your first command.${RESET}"
            echo ""
            press_enter
            return
        fi

        # ── Display numbered table ─────────────────────────────────────────
        echo -e "  ${BOLD}Total Installed: ${YELLOW}${total}${RESET}${BOLD} command(s)${RESET}"
        echo ""
        echo -e "  ${DIM}$(hr '─')${RESET}"

        local i
        for (( i=0; i<total; i++ )); do
            local idx=$(( i + 1 ))
            local name="${CMD_NAMES[$i]}"
            local script="${CMD_SCRIPTS[$i]}"
            local device="${CMD_DEVICES[$i]}"
            local key="${CMD_KEYS[$i]}"

            # Pull enriched info from manual
            local summary added
            summary=$(lookup_summary_from_manual "${name}")
            added=$(lookup_added_from_manual     "${name}")

            # Check if script file still exists on disk
            local script_status
            if [[ -f "${script}" ]]; then
                script_status="${GREEN}✔ exists${RESET}"
            else
                script_status="${RED}✘ not found on disk${RESET}"
            fi

            printf "  ${YELLOW}${BOLD}[%d]${RESET}  ${BOLD}%s${RESET}\n" "${idx}" "${name}"
            printf "       %-14s %s\n"   "Script:"  "${script}"
            printf "       %-14s "       "File Status:"
            echo -e "${script_status}"
            printf "       %-14s %s\n"   "Device:"  "${device}"
            printf "       %-14s %s\n"   "Config Key:"  "${key}"
            printf "       %-14s %s\n"   "Summary:" "${summary}"
            printf "       %-14s %s\n"   "Added:"   "${added}"
            echo ""
            echo -e "  ${DIM}$(hr '─')${RESET}"
        done

        # ── Manual file note ───────────────────────────────────────────────
        echo ""
        if [[ -f "${MANUAL_FILE}" ]]; then
            echo -e "  ${DIM}ℹ  Full manual → ${MANUAL_FILE}${RESET}"
        else
            echo -e "  ${DIM}ℹ  No manual file found yet (created on first command install).${RESET}"
        fi
        echo ""

        # ── Submenu ────────────────────────────────────────────────────────
        echo -e "  ${BOLD}Options:${RESET}"
        echo ""
        echo -e "    ${YELLOW}[1-${total}]${RESET}  Enter a command number to ${RED}remove${RESET} it"
        echo -e "    ${YELLOW}[b]${RESET}      Back to Main Menu"
        echo ""

        local choice
        read -rp "  $(echo -e "${BOLD}Select: ${RESET}")" choice

        # ── Back ───────────────────────────────────────────────────────────
        if [[ "${choice,,}" == "b" ]]; then
            return
        fi

        # ── Numeric → Remove flow ──────────────────────────────────────────
        if [[ "${choice}" =~ ^[0-9]+$ ]] \
           && (( choice >= 1 && choice <= total )); then

            local ridx=$(( choice - 1 ))
            local r_name="${CMD_NAMES[$ridx]}"
            local r_key="${CMD_KEYS[$ridx]}"
            local r_cfg="${CMD_CFGS[$ridx]}"
            local r_device="${CMD_DEVICES[$ridx]}"
            local r_script="${CMD_SCRIPTS[$ridx]}"

            echo ""
            echo -e "${CYAN}$(hr '─')${RESET}"
            echo -e "  ${RED}${BOLD}Remove KDE Connect Command${RESET}"
            echo -e "${CYAN}$(hr '─')${RESET}"
            echo ""
            echo -e "  ${BOLD}Command Name :${RESET} ${YELLOW}${r_name}${RESET}"
            echo -e "  ${BOLD}Script       :${RESET} ${r_script}"
            echo -e "  ${BOLD}Device       :${RESET} ${r_device}"
            echo -e "  ${BOLD}Config Key   :${RESET} ${r_key}"
            echo ""
            echo -e "  ${RED}${BOLD}⚠  This will permanently remove the command from:${RESET}"
            echo -e "  ${DIM}    • The KDE Connect plugin config (command will vanish from the app)${RESET}"
            echo -e "  ${DIM}    • The Congen commands manual (Congen_Commands_List.txt)${RESET}"
            echo -e "  ${DIM}  (Your bash script file on disk will NOT be deleted.)${RESET}"
            echo ""

            local confirm
            read -rp "  $(echo -e "${RED}${BOLD}Type 'yes' to confirm removal, or press Enter to cancel: ${RESET}")" confirm

            if [[ "${confirm,,}" == "yes" ]]; then
                # 1. Remove from KDE config
                remove_command_from_config "${r_cfg}" "${r_key}" "${r_name}" "${r_script}"

                # 2. Remove from manual
                remove_from_manual "${r_name}"

                # 3. Log it
                local timestamp
                timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
                log_entry "REMOVED command '${r_name}' | key='${r_key}' | device='${r_device}' | cfg='${r_cfg}'"
                {
                    echo "========================================"
                    echo "  Congen Remove Summary"
                    echo "  Timestamp    : ${timestamp}"
                    echo "  Command Name : ${r_name}"
                    echo "  Config Key   : ${r_key}"
                    echo "  Device       : ${r_device}"
                    echo "  Config File  : ${r_cfg}"
                    echo "========================================"
                } >> "${LOG_FILE}"

                # 4. Signal daemon to reload (best-effort)
                if command -v qdbus &>/dev/null; then
                    qdbus org.kde.kdeconnect /modules/kdeconnect \
                          org.kde.kdeconnect.daemon.refreshDiscovery 2>/dev/null || true
                fi
                if command -v qdbus6 &>/dev/null; then
                    qdbus6 org.kde.kdeconnect /modules/kdeconnect \
                           org.kde.kdeconnect.daemon.refreshDiscovery 2>/dev/null || true
                fi

                echo ""
                echo -e "  ${GREEN}${BOLD}✔  Command '${r_name}' successfully removed.${RESET}"
                echo ""
                press_enter
            else
                echo ""
                echo -e "  ${DIM}Removal cancelled.${RESET}"
                sleep 1
            fi

        else
            echo -e "\n  ${RED}Invalid selection.${RESET} Enter a number 1–${total} or [b] to go back."
            sleep 1
        fi

        # Unset arrays before next loop iteration
        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
    done
}

