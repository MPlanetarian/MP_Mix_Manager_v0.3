                log_entry "ALERTS ENABLED | daemon started | player=${player}"
                if congen_alerts_is_running; then
                    echo -e "  ${GREEN}${BOLD}✔  Alerts enabled — daemon is now monitoring for KDE Connect commands.${RESET}"
                    echo -e "  ${DIM}  You will hear a chime whenever a command runs.${RESET}"
                else
                    echo -e "  ${YELLOW}${BOLD}⚠  Daemon may not have started. Try option [5] to restart.${RESET}"
                fi
                sleep 2
                ;;
            2)
                congen_alerts_disable
                congen_alerts_stop
                log_entry "ALERTS DISABLED | daemon stopped"
                echo -e "\n  ${GREEN}${BOLD}✔  Alerts disabled and monitoring stopped.${RESET}"
                sleep 2
                ;;
            3)
                echo ""
                echo -e "  ${DIM}Playing test alert now…${RESET}"
                if congen_alerts_play_sound; then
                    echo -e "  ${GREEN}${BOLD}✔  Alert chime played!${RESET}  ${DIM}(two-tone C6 → E6)${RESET}"
                else
                    echo -e "  ${RED}${BOLD}✘  Could not play sound.${RESET}"
                    echo -e "  ${DIM}  Ensure an audio player is installed and your audio output is active.${RESET}"
                    [[ ! -f "${ALERTS_SOUND_FILE}" ]] && \
                    echo -e "  ${YELLOW}  The sound file is missing — run option [4] to regenerate it.${RESET}"
                fi
                sleep 2
                ;;
            4)
                echo ""
                echo -e "  ${DIM}Regenerating alert sound file…${RESET}"
                rm -f "${ALERTS_SOUND_FILE}"
                if congen_alerts_generate_sound; then
                    echo -e "  ${GREEN}${BOLD}✔  New chime generated:${RESET} ${DIM}${ALERTS_SOUND_FILE}${RESET}"
                    echo -e "  ${DIM}  Use option [3] to preview it.${RESET}"
                else
                    echo -e "  ${RED}${BOLD}✘  Generation failed. Ensure python3 is available.${RESET}"
                fi
                sleep 2
                ;;
            5)
                echo ""
                echo -e "  ${DIM}Restarting monitor daemon…${RESET}"
                congen_alerts_stop
                sleep 0.4
                congen_alerts_enable
                congen_alerts_start
                log_entry "ALERTS DAEMON RESTARTED"
                if congen_alerts_is_running; then
                    local rpid; rpid=$(cat "${ALERTS_PID_FILE}" 2>/dev/null || true)
                    echo -e "  ${GREEN}${BOLD}✔  Daemon restarted successfully.${RESET}  ${DIM}(PID: ${rpid})${RESET}"
                else
                    echo -e "  ${YELLOW}${BOLD}⚠  Daemon did not start. Check audio player availability.${RESET}"
                fi
                sleep 2
                ;;
            b|back) return ;;
            *)
                echo -e "\n  ${RED}Invalid option.${RESET} Please select 1–5 or b."
                sleep 1
                ;;
        esac
    done
}

