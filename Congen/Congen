# ── Cancel a scheduled job ────────────────────────────────────────────────────
schedule_cancel() {
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Cancel a Scheduled Job${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    local backend
    backend=$(schedule_detect_backend)

    if [[ "${backend}" == "at" ]]; then
        echo -e "  ${BOLD}Current 'at' queue:${RESET}"
        echo ""
        local atq_out
        atq_out=$(atq 2>/dev/null || true)
        if [[ -z "${atq_out}" ]]; then
            echo -e "  ${DIM}No pending 'at' jobs.${RESET}"
            echo ""
            press_enter; return
        fi
        echo "${atq_out}" | while IFS= read -r line; do
            echo "    ${line}"
        done
        echo ""
        local job_num
        read -rp "  $(echo -e "${BOLD}Enter 'at' job number to cancel (or Enter to abort): ${RESET}")" job_num
        if [[ -z "${job_num}" ]]; then
            echo -e "  ${DIM}Cancelled.${RESET}"; sleep 1; return
        fi
        if [[ "${job_num}" =~ ^[0-9]+$ ]]; then
            set +e
            atrm "${job_num}" 2>/dev/null
            local rm_ec=$?
            set -e
            if [[ ${rm_ec} -eq 0 ]]; then
                echo -e "\n  ${GREEN}${BOLD}✔  Job ${job_num} removed from the 'at' queue.${RESET}"
                log_entry "SCHEDULE CANCEL | backend=at | job_id=${job_num}"
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] CANCELLED job ${job_num} (at)" >> "${LOG_FILE}"
            else
                echo -e "\n  ${RED}✘  Could not remove job ${job_num}. Check the number and try again.${RESET}"
            fi
        else
            echo -e "  ${RED}Invalid job number.${RESET}"
        fi

    elif [[ "${backend}" == "systemd-run" ]]; then
        echo -e "  ${BOLD}Active Congen systemd timer units:${RESET}"
        echo ""
        local timers
        timers=$(systemctl --user list-timers 'congen-job-*' \
                     --no-legend 2>/dev/null || true)
        if [[ -z "${timers}" ]]; then
            echo -e "  ${DIM}No active Congen timer units found.${RESET}"
            echo ""
            press_enter; return
        fi
        echo "${timers}"
        echo ""
        local unit_name
        read -rp "  $(echo -e "${BOLD}Enter unit name to cancel (e.g. congen-job-20260919_143000): ${RESET}")" unit_name
        if [[ -z "${unit_name}" ]]; then
            echo -e "  ${DIM}Cancelled.${RESET}"; sleep 1; return
        fi
        set +e
        systemctl --user stop  "${unit_name}.timer"  2>/dev/null
        systemctl --user disable "${unit_name}.timer" 2>/dev/null
        local sd_ec=$?
        set -e
        if [[ ${sd_ec} -eq 0 ]]; then
            echo -e "\n  ${GREEN}${BOLD}✔  Timer unit '${unit_name}' stopped and disabled.${RESET}"
            log_entry "SCHEDULE CANCEL | backend=systemd-run | unit=${unit_name}"
        else
            echo -e "\n  ${RED}✘  Could not cancel unit '${unit_name}'.${RESET}"
        fi

    else
        echo -e "  ${DIM}No scheduling backend available.${RESET}"
    fi

    echo ""
    press_enter
}

