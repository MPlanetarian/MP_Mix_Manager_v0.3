# ---------------------------------------------------------------------------
# Export KDE Connect commands
# ---------------------------------------------------------------------------
export_commands() {
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Export KDE Connect Commands${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    # Collect live commands
    declare -a CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
    collect_all_commands

    local total="${#CMD_KEYS[@]}"

    if [[ ${total} -eq 0 ]]; then
        echo -e "  ${YELLOW}No commands to export. Create some commands first.${RESET}"
        echo ""
        press_enter
        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        return
    fi

    echo -e "  ${BOLD}${total}${RESET} command(s) available for export."
    echo ""

    # Ask for export base path (default = SCRIPT_DIR)
    echo -e "  ${BOLD}Export destination path${RESET}"
    echo -e "  ${DIM}Commands will be saved to: <path>/CONGEN_EXPORT/${RESET}"
    echo -e "  ${DIM}Press Enter to use the default (script directory).${RESET}"
    echo ""
    local export_base
    read -rp "  $(echo -e "${BOLD}Path [${SCRIPT_DIR}]: ${RESET}")" export_base
    export_base="${export_base/#\~/$HOME}"
    [[ -z "${export_base}" ]] && export_base="${SCRIPT_DIR}"

    local export_dir="${export_base}/CONGEN_EXPORT"
    mkdir -p "${export_dir}"

    local timestamp
    timestamp="$(date '+%Y-%m-%d_%H-%M-%S')"
    local export_ts_dir="${export_dir}/${timestamp}"
    mkdir -p "${export_ts_dir}"

    echo ""
    echo -e "  ${DIM}Exporting to: ${export_ts_dir}${RESET}"
    echo ""

    local exported=0
    local -a exported_names=()

    local i
    for (( i=0; i<total; i++ )); do
        local name="${CMD_NAMES[$i]}"
        local script="${CMD_SCRIPTS[$i]}"
        local device="${CMD_DEVICES[$i]}"
        local key="${CMD_KEYS[$i]}"

        local summary added
        summary=$(lookup_summary_from_manual "${name}")
        added=$(lookup_added_from_manual     "${name}")

        # Sanitise name for filename (replace spaces/slashes)
        local safe_name
        safe_name="${name//[^a-zA-Z0-9_-]/_}"

        local out_file="${export_ts_dir}/${safe_name}.congen"
        cat > "${out_file}" <<CONGEN_ENTRY
# Congen Export File
# Generated by Congen v1.0.0
# Exported : $(date '+%Y-%m-%d %H:%M:%S')
[command]
name=${name}
script=${script}
device=${device}
config_key=${key}
summary=${summary}
added=${added}
CONGEN_ENTRY

        exported_names+=("${name}")
        (( exported++ ))
        printf "    ${GREEN}✔${RESET}  Exported: ${BOLD}%s${RESET} → %s\n" \
               "${name}" "$(basename "${out_file}")"
    done

    # Also copy the manual file if it exists
    if [[ -f "${MANUAL_FILE}" ]]; then
        cp "${MANUAL_FILE}" "${export_ts_dir}/Congen_Commands_List.txt"
        echo ""
        echo -e "    ${GREEN}✔${RESET}  Commands list  → Congen_Commands_List.txt"
    fi

    # Write manifest
    local manifest="${export_ts_dir}/EXPORT_MANIFEST.txt"
    {
        echo "========================================"
        echo "  Congen Export Manifest"
        echo "  Exported       : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "  Total Commands : ${exported}"
        echo "  Destination    : ${export_ts_dir}"
        echo "========================================"
        echo ""
        for n in "${exported_names[@]}"; do
            echo "  • ${n}"
        done
    } > "${manifest}"

    # Log it
    log_entry "EXPORT | ${exported} command(s) → ${export_ts_dir}"
    {
        echo "========================================"
        echo "  Congen Export Summary"
        echo "  Timestamp      : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "  Total Exported : ${exported}"
        echo "  Export Path    : ${export_ts_dir}"
        for n in "${exported_names[@]}"; do
            echo "  • ${n}"
        done
        echo "========================================"
    } >> "${LOG_FILE}"

    echo ""
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo -e "  ${GREEN}${BOLD}✔  Export complete!${RESET}"
    echo -e "  ${BOLD}Total Exported :${RESET} ${YELLOW}${exported}${RESET} command(s)"
    echo -e "  ${BOLD}Export Folder  :${RESET} ${export_ts_dir}"
    echo -e "  ${BOLD}Manifest       :${RESET} ${manifest}"
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo ""

    unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
    press_enter
}

# ---------------------------------------------------------------------------
# Import KDE Connect commands
# ---------------------------------------------------------------------------
import_commands() {
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Import KDE Connect Commands${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    local import_dir="${SCRIPT_DIR}/CONGEN_IMPORT"

    # Always ensure the import dir exists
    mkdir -p "${import_dir}"

    echo -e "  ${BOLD}Import directory:${RESET} ${YELLOW}${import_dir}${RESET}"
    echo ""
    echo -e "  ${DIM}Place your ${BOLD}.congen${RESET}${DIM} export files into the directory above,${RESET}"
    echo -e "  ${DIM}then press Enter to continue.${RESET}"
    echo ""
    echo -e "  ${DIM}  • Each .congen file represents one KDE Connect command.${RESET}"
    echo -e "  ${DIM}  • Files are created by the Congen Export function.${RESET}"
    echo ""
    press_enter

    # Scan for .congen files
    local -a congen_files=()
    while IFS= read -r -d '' f; do
        congen_files+=("$f")
    done < <(find "${import_dir}" -maxdepth 2 -name "*.congen" -print0 2>/dev/null || true)

    if [[ ${#congen_files[@]} -eq 0 ]]; then
        echo -e "  ${RED}No .congen files found in:${RESET}"
        echo -e "  ${DIM}  ${import_dir}${RESET}"
        echo ""
        echo -e "  ${YELLOW}Tip:${RESET} Export commands from another Congen instance first,"
        echo -e "  ${DIM}  then copy the .congen files into the CONGEN_IMPORT directory.${RESET}"
        echo ""
        press_enter
        return
    fi

    echo ""
    echo -e "  ${BOLD}Found ${YELLOW}${#congen_files[@]}${RESET}${BOLD} .congen file(s) to import:${RESET}"
    echo ""

    local fi
    for (( fi=0; fi<${#congen_files[@]}; fi++ )); do
        local fname
        fname="$(basename "${congen_files[$fi]}")"
        local imp_name
        imp_name=$(grep '^name=' "${congen_files[$fi]}" 2>/dev/null | head -1 | cut -d'=' -f2- || true)
        printf "    ${YELLOW}[%d]${RESET}  %-30s  ${DIM}Command: %s${RESET}\n" \
               "$(( fi+1 ))" "${fname}" "${imp_name:-unknown}"
    done

    echo ""

    # Pick a device to register to
    echo -e "  ${BOLD}${CYAN}Select target device for import:${RESET}"
    local plugin_dir
    plugin_dir=$(pick_device_config_dir) || {
        echo -e "  ${RED}Import aborted — no paired device available.${RESET}"
        press_enter
        return
    }

    local -a target_plugin_dirs=()
    local -a target_dev_names=()
    local -a target_dev_ids=()

    if [[ "${plugin_dir}" == "ALL" ]]; then
        while IFS= read -r pdir; do
            [[ -n "${pdir}" ]] || continue
            target_plugin_dirs+=("${pdir}")
            local did="$(basename "$(dirname "${pdir}")")"
            target_dev_ids+=("${did}")
            local dname="${did}"
            local dcfg="$(dirname "${pdir}")/config"
            if [[ -f "${dcfg}" ]]; then
                dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
            fi
            target_dev_names+=("${dname}")
        done < <(get_all_paired_device_plugin_dirs)
    else
        target_plugin_dirs+=("${plugin_dir}")
        local did="$(basename "$(dirname "${plugin_dir}")")"
        target_dev_ids+=("${did}")
        local dname="${did}"
        local dcfg="$(dirname "${plugin_dir}")/config"
        if [[ -f "${dcfg}" ]]; then
            dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
        fi
        target_dev_names+=("${dname}")
    fi

    echo ""
    local imported=0
    local skipped=0
    local -a imported_names=() skipped_names=()

    for congen_file in "${congen_files[@]}"; do
        # Parse fields safely
        local imp_name imp_script imp_summary imp_added
        imp_name=$(grep '^name=' "${congen_file}" 2>/dev/null | head -1 | cut -d'=' -f2- || true)
        imp_script=$(grep '^script=' "${congen_file}" 2>/dev/null | head -1 | cut -d'=' -f2- || true)
        imp_summary=$(grep '^summary=' "${congen_file}" 2>/dev/null | head -1 | cut -d'=' -f2- || true)
        imp_added=$(grep '^added=' "${congen_file}" 2>/dev/null | head -1 | cut -d'=' -f2- || true)

        if [[ -z "${imp_name}" || -z "${imp_script}" ]]; then
            echo -e "  ${YELLOW}⚠  Skipping malformed file:${RESET} $(basename "${congen_file}")"
            skipped=$(( skipped + 1 ))
            skipped_names+=("$(basename "${congen_file}")")
            continue
        fi

        local registered_any=0
        for (( ti=0; ti<${#target_plugin_dirs[@]}; ti++ )); do
            local cfg_file="${target_plugin_dirs[$ti]}/config"
            local device_name="${target_dev_names[$ti]}"
            mkdir -p "$(dirname "${cfg_file}")"

            # Check if identical command already exists in target config (ByteArray & INI)
            local already_exists=0
            if [[ -f "${cfg_file}" ]]; then
                if grep -q "@ByteArray" "${cfg_file}" 2>/dev/null; then
                    already_exists=$(python3 - "${cfg_file}" "${imp_name}" "${imp_script}" <<'PYEOF'
import sys, json
cfg_path, name, script = sys.argv[1], sys.argv[2], sys.argv[3]
exists = 0
try:
    with open(cfg_path, 'r', encoding='utf-8', errors='ignore') as f:
        for line in f:
            line = line.strip()
            if line.startswith("commands="):
                raw = line[len("commands="):].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if raw.startswith("@ByteArray(") and raw.endswith(")"):
                    raw = raw[len("@ByteArray("):-1].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if r'\"' in raw:
                    raw = raw.replace(r'\"', '"')
                data = json.loads(raw)
                if isinstance(data, str): data = json.loads(data)
                if isinstance(data, dict):
                    for u, entry in data.items():
                        if isinstance(entry, dict):
                            if entry.get("name") == name or entry.get("command") == script:
                                exists = 1
                                break
                break
except Exception:
    pass
print(exists)
PYEOF
)
                fi
                if [[ "${already_exists}" != "1" ]]; then
                    while IFS= read -r existing_script; do
                        local clean_existing clean_imp
                        clean_existing=$(echo "${existing_script}" | sed -e 's/\\n//g' -e 's/\r//g' | xargs)
                        clean_imp=$(echo "${imp_script}" | sed -e 's/\\n//g' -e 's/\r//g' | xargs)
                        if [[ "${clean_existing}" == "${clean_imp}" ]]; then
                            already_exists=1
                            break
                        fi
                    done < <(grep -E '^cmd[0-9]+\\command=' "${cfg_file}" 2>/dev/null | cut -d'=' -f2- || true)
                fi
            fi

            if (( already_exists == 1 )); then
                continue
            fi

            # Get next available key
            local cmd_key
            cmd_key=$(next_command_key "${cfg_file}") || true
            [[ -z "${cmd_key}" ]] && cmd_key="cmd0"

            # Write to KDE config
            write_command_to_config "${cfg_file}" "${cmd_key}" "${imp_name}" "${imp_script}" || true
            registered_any=1

            if declare -F log_entry &>/dev/null; then
                log_entry "IMPORTED command '${imp_name}' | script='${imp_script}' | device='${device_name}' | key='${cmd_key}'" || true
            fi
        done

        if (( registered_any == 1 )); then
            # Write to manual (only if not already in it)
            local existing_summary="—"
            if declare -F lookup_summary_from_manual &>/dev/null; then
                existing_summary=$(lookup_summary_from_manual "${imp_name}" 2>/dev/null || echo "—")
            fi

            if [[ "${existing_summary}" == "—" ]] && declare -F update_manual &>/dev/null; then
                update_manual "${imp_name}" "${imp_script}" "${imp_summary:-Imported via Congen}" || true
            fi

            printf "    ${GREEN}✔${RESET}  Imported: ${BOLD}%s${RESET}\n" "${imp_name}"
            imported_names+=("${imp_name}")
            imported=$(( imported + 1 ))
        else
            printf "    ${DIM}•  Already registered: %s (skipped)${RESET}\n" "${imp_name}"
            skipped=$(( skipped + 1 ))
            skipped_names+=("${imp_name} (already exists)")
        fi
    done

    # Signal daemon / device to reload commands
    local qdbus_bin=""
    if command -v qdbus6 &>/dev/null; then
        qdbus_bin="qdbus6"
    elif command -v qdbus &>/dev/null; then
        qdbus_bin="qdbus"
    fi

    if [[ -n "${qdbus_bin}" ]]; then
        # 1. Plasma 6 daemon-level discovery/network trigger
        "${qdbus_bin}" org.kde.kdeconnect /modules/kdeconnect \
            org.kde.kdeconnect.daemon.forceOnNetworkChange &>/dev/null || true

        # 2. Targeted device plugin reload
        for did in "${target_dev_ids[@]}"; do
            if [[ -n "${did}" ]]; then
                "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${did}" \
                    org.kde.kdeconnect.device.reloadPlugins &>/dev/null || true
                "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${did}/runcommand" \
                    org.kde.kdeconnect.device.runcommand.reload &>/dev/null || true
            fi
        done
    fi

    # Write summary to log
    if [[ -n "${LOG_FILE:-}" ]]; then
        {
            echo "========================================"
            echo "  Congen Import Summary"
            echo "  Timestamp      : $(date '+%Y-%m-%d %H:%M:%S')"
            echo "  Target Device  : ${device_name}"
            echo "  Total Imported : ${imported}"
            echo "  Total Skipped  : ${skipped}"
            for n in "${imported_names[@]}"; do echo "  ✔ ${n}"; done
            for n in "${skipped_names[@]}";  do echo "  ✘ ${n} (skipped)"; done
            echo "========================================"
        } >> "${LOG_FILE}" 2>/dev/null || true
    fi

    echo ""
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo -e "  ${GREEN}${BOLD}✔  Import complete!${RESET}"
    echo -e "  ${BOLD}Imported :${RESET} ${GREEN}${imported}${RESET} command(s)"
    [[ ${skipped} -gt 0 ]] && \
    echo -e "  ${BOLD}Skipped  :${RESET} ${YELLOW}${skipped}${RESET} file(s)  ${DIM}(malformed or missing fields)${RESET}"
    echo -e "  ${BOLD}Device   :${RESET} ${device_name}"
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo ""
    press_enter
}

