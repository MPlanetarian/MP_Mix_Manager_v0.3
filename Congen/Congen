    f.write(w + '\n')
    f.write(f'  End of Congen Commands Manual  |  Generated by Congen v1.0.0\n')
    f.write(w + '\n')
PYEOF

    echo -e "${GREEN}${BOLD}✔${RESET}"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # 2 ── GENERATE HTML
