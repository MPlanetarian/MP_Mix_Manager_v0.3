# ---------------------------------------------------------------------------
# Import Existing KDE Commands from the System (With Deduplication Support)
# ---------------------------------------------------------------------------
import_existing_kdeconnect_commands() {
    local kdeconnect_dir="${HOME}/.config/kdeconnect"
    local import_dir="${CONGEN_IMPORT_DIR:-${SCRIPT_DIR}/CONGEN_IMPORT}"

    if [[ ! -d "${kdeconnect_dir}" ]]; then
        echo -e "\n[!] KDE Connect configuration directory not found at: ${kdeconnect_dir}"
        read -r -p "Press Enter to return..."
        return 0
    fi

    mkdir -p "${import_dir}"
    echo -e "\n[*] Scanning for existing KDE Connect commands across devices..."

    python3 - "${kdeconnect_dir}" "${import_dir}" << 'EOF'
import sys
import os
import re
import json
import hashlib
from datetime import datetime

kdeconnect_dir = sys.argv[1]
import_dir = sys.argv[2]

count = 0
dupe_count = 0

seen_signatures = set()
seen_filenames = set()

# Index existing .congen files in import_dir
if os.path.isdir(import_dir):
    for f in os.listdir(import_dir):
        if f.endswith(".congen"):
            seen_filenames.add(f)

# Find all device subdirectories
dev_dirs = [os.path.join(kdeconnect_dir, d) for d in os.listdir(kdeconnect_dir)
            if os.path.isdir(os.path.join(kdeconnect_dir, d))]

for dev_dir in dev_dirs:
    # Resolve friendly device name
    dev_config = os.path.join(dev_dir, "config")
    device_name = os.path.basename(dev_dir)
    if os.path.isfile(dev_config):
        try:
            with open(dev_config, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if line.startswith("name="):
                        val = line.split("=", 1)[1].strip()
                        if val:
                            device_name = val
                        break
        except Exception:
            pass

    # Collect config and backup files in kdeconnect_runcommand
    runcmd_dir = os.path.join(dev_dir, "kdeconnect_runcommand")
    if not os.path.isdir(runcmd_dir):
        continue

    runcmd_files = []
    for fname in os.listdir(runcmd_dir):
        if fname == "config" or fname.startswith("config.bak"):
            runcmd_files.append(os.path.join(runcmd_dir, fname))

    # Process newest/active config files first
    runcmd_files.sort(key=lambda x: os.path.getmtime(x), reverse=True)

    for rfile in runcmd_files:
        try:
            with open(rfile, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()
        except Exception:
            continue

        for line in lines:
            line = line.strip()
            if not line.startswith("commands="):
                continue

            raw = line[len("commands="):].strip()

            # Strip outer single or double quotes
            if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                raw = raw[1:-1].strip()

            # Strip @ByteArray(...) wrapper
            if raw.startswith("@ByteArray(") and raw.endswith(")"):
                raw = raw[len("@ByteArray("):-1].strip()

            # Second quote strip if inner string was quoted
            if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                raw = raw[1:-1].strip()

            # Unescape \" if JSON string was escaped
            if r'\"' in raw:
                raw = raw.replace(r'\"', '"')

            data = None
            try:
                data = json.loads(raw)
            except Exception:
                pass

            # Handle second-level string decode if double-serialized
            if isinstance(data, str):
                try:
                    data = json.loads(data)
                except Exception:
                    data = None

            if not isinstance(data, dict):
                continue

            for key, val in data.items():
                if not isinstance(val, dict):
                    continue

                cmd_name = val.get("name", "").strip()
                cmd_exec = val.get("command", "").strip()

                if not cmd_name or not cmd_exec:
                    continue

                # Strip trailing newlines or carriage returns from commands
                cmd_exec = cmd_exec.replace("\\n", "").replace("\r", "").replace("\n", "").strip()

                # Deduplicate identical name + script definitions
                sig = hashlib.sha256(f"{cmd_name}\0{cmd_exec}".encode("utf-8")).hexdigest()
                if sig in seen_signatures:
                    dupe_count += 1
                    continue
                seen_signatures.add(sig)

                # Generate clean filename
                safe_name = re.sub(r"[ /]", "_", cmd_name)
                safe_name = re.sub(r"[^a-zA-Z0-9_\-]", "", safe_name)
                if not safe_name:
                    safe_name = f"kde_cmd_{key}"

                final_name = f"{safe_name}.congen"
                idx = 1
                skip_item = False

                while final_name in seen_filenames:
                    target_path = os.path.join(import_dir, final_name)
                    if os.path.isfile(target_path):
                        try:
                            with open(target_path, "r", encoding="utf-8", errors="ignore") as f:
                                for tline in f:
                                    if tline.startswith("script="):
                                        if tline.split("=", 1)[1].strip() == cmd_exec:
                                            dupe_count += 1
                                            skip_item = True
                                            break
                        except Exception:
                            pass
                    if skip_item:
                        break
                    final_name = f"{safe_name}_{idx}.congen"
                    idx += 1

                if skip_item:
                    continue

                seen_filenames.add(final_name)
                target_congen = os.path.join(import_dir, final_name)
                now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

                congen_content = (
                    "# Congen Export File\n"
                    "# Imported via Congen Legacy Discovery\n"
                    f"# Exported : {now_str}\n"
                    "[command]\n"
                    f"name={cmd_name}\n"
                    f"script={cmd_exec}\n"
                    f"device={device_name}\n"
                    f"config_key={key}\n"
                    f"summary={cmd_name} (Imported from {device_name})\n"
                    f"added={now_str}\n"
                )

                try:
                    with open(target_congen, "w", encoding="utf-8") as out:
                        out.write(congen_content)
                    print(f'  [+] Imported: {final_name} ("{cmd_name}" from {device_name})')
                    count += 1
                except Exception as e:
                    print(f'  [-] Error writing {final_name}: {e}')

print(f"\n[✓] Successfully imported {count} unique legacy command(s) into {import_dir}")
if dupe_count > 0:
    print(f"[i] Deduplicated {dupe_count} duplicate command instance(s) found across backups.")
EOF

    echo ""
    read -r -p "Press Enter to return..."
}

# ---------------------------------------------------------------------------
# Run a KDE Connect Command
# ---------------------------------------------------------------------------
run_command_menu() {
    while true; do
        clear
        echo ""
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Run KDE Connect Command${RESET}"
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo ""

        # ── Collect installed commands ─────────────────────────────────────
        declare -a CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        collect_all_commands

        local total="${#CMD_KEYS[@]}"

        if [[ ${total} -eq 0 ]]; then
            echo -e "  ${YELLOW}No KDE Connect commands are currently installed.${RESET}"
            echo -e "  ${DIM}Use option 1 from the main menu to create your first command.${RESET}"
            echo ""
            press_enter
            unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
            return
        fi

        # ── Display numbered list ──────────────────────────────────────────
        echo -e "  ${BOLD}Installed Commands  —  select one to run:${RESET}"
        echo ""
        echo -e "  ${DIM}$(hr '─')${RESET}"

        local i
        for (( i=0; i<total; i++ )); do
            local idx=$(( i + 1 ))
            local name="${CMD_NAMES[$i]}"
            local script="${CMD_SCRIPTS[$i]}"
            local device="${CMD_DEVICES[$i]}"

            local summary
            summary=$(lookup_summary_from_manual "${name}")

            # Script-on-disk indicator
            local script_indicator
            if [[ -f "${script}" && -x "${script}" ]]; then
                script_indicator="${GREEN}● ready${RESET}"
            elif [[ -f "${script}" ]]; then
                script_indicator="${YELLOW}⚠ not executable${RESET}"
            else
                script_indicator="${RED}✘ script not found${RESET}"
            fi

            printf "  ${YELLOW}${BOLD}[%d]${RESET}  ${BOLD}%-28s${RESET}  " "${idx}" "${name}"
            echo -e "${script_indicator}"
            printf "       ${DIM}Script : %s${RESET}\n" "${script}"
            printf "       ${DIM}Device : %s${RESET}\n" "${device}"
            printf "       ${DIM}Summary: %s${RESET}\n" "${summary}"
            echo ""
        done

        echo -e "  ${DIM}$(hr '─')${RESET}"
        echo ""
        echo -e "    ${YELLOW}[1-${total}]${RESET}  Select a command number to run it"
        echo -e "    ${YELLOW}[b]${RESET}      Back to Main Menu"
        echo ""

        local choice
        read -rp "  $(echo -e "${BOLD}Select: ${RESET}")" choice

        # ── Back ───────────────────────────────────────────────────────────
        if [[ "${choice,,}" == "b" ]]; then
            unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
            return
        fi

        # ── Validate numeric choice ────────────────────────────────────────
        if ! [[ "${choice}" =~ ^[0-9]+$ ]] \
           || (( choice < 1 || choice > total )); then
            echo -e "\n  ${RED}Invalid selection.${RESET} Enter a number 1–${total} or [b]."
            sleep 1
            unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
            continue
        fi

        local ridx=$(( choice - 1 ))
        local r_name="${CMD_NAMES[$ridx]}"
        local r_script="${CMD_SCRIPTS[$ridx]}"
        local r_device="${CMD_DEVICES[$ridx]}"

        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS

        # ── Pre-flight checks ──────────────────────────────────────────────
        clear
        echo ""
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Running: ${YELLOW}${r_name}${RESET}"
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo ""
        echo -e "  ${BOLD}Command  :${RESET} ${r_name}"
        echo -e "  ${BOLD}Script   :${RESET} ${r_script}"
        echo -e "  ${BOLD}Device   :${RESET} ${r_device}"
        echo ""

        local target_bin="${r_script%% *}"
        if [[ ! -f "${r_script}" && ! -f "${target_bin}" && ! -x "$(command -v "${target_bin}" 2>/dev/null)" ]]; then
            echo -e "  ${RED}${BOLD}✘  ERROR:${RESET} Script or command not found on disk / PATH:"
            echo -e "  ${DIM}  ${r_script}${RESET}"
            echo ""
            log_entry "RUN FAILED (script not found) | command='${r_name}' | script='${r_script}'"
            {
                echo "========================================"
                echo "  Congen Run Audit"
                echo "  Timestamp  : $(date '+%Y-%m-%d %H:%M:%S')"
                echo "  Command    : ${r_name}"
                echo "  Script     : ${r_script}"
                echo "  Device     : ${r_device}"
                echo "  Status     : FAILED — script not found on disk"
                echo "  Exit Code  : N/A"
                echo "========================================"
            } >> "${LOG_FILE}"
            press_enter
            continue
        fi

        if [[ -f "${r_script}" && ! -x "${r_script}" ]]; then
            echo -e "  ${YELLOW}${BOLD}⚠  Script is not executable. Fixing now…${RESET}"
            chmod +x "${r_script}"
            echo -e "  ${GREEN}Done — executable bit set.${RESET}"
            echo ""
        fi

        echo -e "${CYAN}$(hr '─')${RESET}"
        echo -e "  ${BOLD}${WHITE}▶  Execution Log${RESET}"
        echo -e "${CYAN}$(hr '─')${RESET}"
        echo ""

        local run_start run_end elapsed
        run_start="$(date '+%Y-%m-%d %H:%M:%S')"
        local start_epoch
        start_epoch=$(date +%s)

        # ── Execute: capture stdout+stderr, stream to screen, save to var ──
        local run_output=""
        local exit_code=0

        # Use a temp file so we can stream AND capture simultaneously
        local tmp_out
        tmp_out="$(mktemp /tmp/congen_run_XXXXXX.log)"

        # Run the script; tee to temp file while displaying live output
        # Disable strict exit-on-error for the user script block
        set +e
        if [[ -f "${r_script}" && -x "${r_script}" ]]; then
            "${r_script}" 2>&1 | tee "${tmp_out}"
        else
            bash -c "${r_script}" 2>&1 | tee "${tmp_out}"
        fi
        exit_code="${PIPESTATUS[0]}"
        set -e

        run_output="$(cat "${tmp_out}")"
        rm -f "${tmp_out}"

        local end_epoch
        end_epoch=$(date +%s)
        run_end="$(date '+%Y-%m-%d %H:%M:%S')"
        elapsed=$(( end_epoch - start_epoch ))

        echo ""
        echo -e "${CYAN}$(hr '─')${RESET}"

        # ── Status result ──────────────────────────────────────────────────
        local status_label status_color
        if [[ ${exit_code} -eq 0 ]]; then
            status_color="${GREEN}"
            status_label="SUCCESS"
            echo -e "  ${GREEN}${BOLD}✔  Command completed successfully.${RESET}"
        else
            status_color="${RED}"
            status_label="FAILED"
            echo -e "  ${RED}${BOLD}✘  Command exited with errors.${RESET}"
        fi

        echo ""
        echo -e "  ${BOLD}Exit Code   :${RESET} ${status_color}${BOLD}${exit_code}${RESET}"
        echo -e "  ${BOLD}Started     :${RESET} ${run_start}"
        echo -e "  ${BOLD}Finished    :${RESET} ${run_end}"
        echo -e "  ${BOLD}Duration    :${RESET} ${elapsed}s"
        echo -e "  ${BOLD}Status      :${RESET} ${status_color}${BOLD}${status_label}${RESET}"
        echo ""
        echo -e "${CYAN}$(hr '─')${RESET}"
        echo -e "  ${DIM}Audit entry written to: ${LOG_FILE}${RESET}"
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo ""

        # ── Write full audit entry to Congen.log ───────────────────────────
        log_entry "RUN ${status_label} | command='${r_name}' | exit=${exit_code} | duration=${elapsed}s | script='${r_script}'"
        {
            echo "========================================"
            echo "  Congen Run Audit"
            echo "  Timestamp  : ${run_start}"
            echo "  Command    : ${r_name}"
            echo "  Script     : ${r_script}"
            echo "  Device     : ${r_device}"
            echo "  Status     : ${status_label}"
            echo "  Exit Code  : ${exit_code}"
            echo "  Started    : ${run_start}"
            echo "  Finished   : ${run_end}"
            echo "  Duration   : ${elapsed}s"
            echo "  ── Output ──────────────────────────────"
            if [[ -n "${run_output}" ]]; then
                echo "${run_output}" | sed 's/^/  | /'
            else
                echo "  | (no output produced)"
            fi
            echo "========================================"
        } >> "${LOG_FILE}"

        press_enter
    done
}

# ---------------------------------------------------------------------------
# Schedule Congen Commands — helpers & submenu
# ---------------------------------------------------------------------------

SCHEDULE_FILE="${SCRIPT_DIR}/Congen_Schedule.txt"
SCHEDULE_JOBS_DIR="${SCRIPT_DIR}/.congen_jobs"

# ── Detect which backend is available for scheduling ─────────────────────────
schedule_detect_backend() {
    # Prefer 'at'; fall back to systemd-run --user
    if command -v at &>/dev/null; then
        echo "at"
    elif systemctl --user status &>/dev/null \
         && command -v systemd-run &>/dev/null; then
        echo "systemd-run"
    else
        echo "none"
    fi
}

# ── Validate a user-supplied datetime string ──────────────────────────────────
schedule_validate_datetime() {
    # Accepts: "YYYY-MM-DD HH:MM" or "YYYY-MM-DD HH:MM:SS"
    local dt="$1"
    if date -d "${dt}" &>/dev/null 2>&1; then
        local epoch
        epoch=$(date -d "${dt}" +%s)
        local now
        now=$(date +%s)
        if (( epoch <= now )); then
            echo "past"
        else
            echo "ok"
        fi
    else
        echo "invalid"
    fi
}

# ── Write an entry to the schedule file ──────────────────────────────────────
schedule_record() {
    local job_id="$1"
    local job_time="$2"
    local job_script="$3"
    local cmd_list="$4"     # pipe-separated command names
    local backend="$5"

    mkdir -p "${SCRIPT_DIR}"
    {
        echo "────────────────────────────────────────────────────────────────────────────────"
        echo "  Job ID     : ${job_id}"
        echo "  Backend    : ${backend}"
        echo "  Scheduled  : ${job_time}"
        echo "  Commands   : ${cmd_list}"
        echo "  Job Script : ${job_script}"
        echo "  Created    : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "────────────────────────────────────────────────────────────────────────────────"
        echo ""
    } >> "${SCHEDULE_FILE}"
}

# ── Create a new scheduled job ────────────────────────────────────────────────
schedule_create() {
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Schedule Congen Commands${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    # Guard: need ≥1 command installed
    declare -a CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
    collect_all_commands
    local total="${#CMD_KEYS[@]}"

    if [[ ${total} -eq 0 ]]; then
        echo -e "  ${YELLOW}No KDE Connect commands installed.${RESET}"
        echo -e "  ${DIM}Create at least one command via the main menu first.${RESET}"
        echo ""
        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        press_enter
        return
    fi

    # Check backend
    local backend
    backend=$(schedule_detect_backend)
    if [[ "${backend}" == "none" ]]; then
        echo -e "  ${RED}${BOLD}✘  No scheduling backend found.${RESET}"
        echo -e "  ${DIM}  Install 'at' (sudo dnf/apt install at) or ensure systemd-run is available.${RESET}"
        echo ""
        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        press_enter
        return
    fi

    echo -e "  ${DIM}Scheduling backend: ${BOLD}${backend}${RESET}"
    echo ""

    # ── Step 1: display available commands ────────────────────────────────────
    echo -e "  ${BOLD}Available Commands:${RESET}"
    echo ""
    local i
    for (( i=0; i<total; i++ )); do
        local summary
        summary=$(lookup_summary_from_manual "${CMD_NAMES[$i]}")
        printf "    ${YELLOW}[%d]${RESET}  ${BOLD}%-28s${RESET}  ${DIM}%s${RESET}\n" \
               "$(( i+1 ))" "${CMD_NAMES[$i]}" "${summary}"
    done
    echo ""

    # ── Step 2: multi-select commands ─────────────────────────────────────────
    echo -e "  ${BOLD}Select commands to run sequentially.${RESET}"
    echo -e "  ${DIM}Enter numbers separated by spaces (e.g. 1 3 2). Order determines run order.${RESET}"
    echo ""
    local selection_input
    read -rp "  $(echo -e "${BOLD}Command selection: ${RESET}")" selection_input

    if [[ -z "${selection_input}" ]]; then
        echo -e "  ${RED}No commands selected. Aborting.${RESET}"
        unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS
        sleep 1; return
    fi

    # Parse + validate each number
    local -a sel_indices=()
    local -a sel_names=()
    local -a sel_scripts=()
    local bad=0

    for tok in ${selection_input}; do
        if ! [[ "${tok}" =~ ^[0-9]+$ ]] || (( tok < 1 || tok > total )); then
            echo -e "  ${RED}Invalid selection: '${tok}'. Aborting.${RESET}"
            bad=1; break
        fi
        local idx=$(( tok - 1 ))
        sel_indices+=("${idx}")
        sel_names+=("${CMD_NAMES[$idx]}")
        sel_scripts+=("${CMD_SCRIPTS[$idx]}")
    done

    unset CMD_KEYS CMD_NAMES CMD_SCRIPTS CMD_DEVICES CMD_CFGS

    [[ ${bad} -eq 1 ]] && { sleep 1; return; }

    echo ""
    echo -e "  ${BOLD}Commands queued in order:${RESET}"
    local seq_num=1
    for n in "${sel_names[@]}"; do
        printf "    ${CYAN}%d.${RESET} %s\n" "${seq_num}" "${n}"
        (( seq_num++ ))
    done

    # ── Step 3: date & time input ─────────────────────────────────────────────
    echo ""
    echo -e "  ${BOLD}Schedule date & time${RESET}"
    echo -e "  ${DIM}Format: YYYY-MM-DD HH:MM   (24-hour, local time)${RESET}"
    echo -e "  ${DIM}Example: $(date -d '+1 hour' '+%Y-%m-%d %H:%M')${RESET}"
    echo ""
    local run_datetime
    local dt_status
    while true; do
        read -rp "  $(echo -e "${BOLD}Run at: ${RESET}")" run_datetime
        dt_status=$(schedule_validate_datetime "${run_datetime}")
        if [[ "${dt_status}" == "ok" ]]; then
            break
        elif [[ "${dt_status}" == "past" ]]; then
            echo -e "  ${RED}That date/time is in the past. Please enter a future time.${RESET}"
        else
            echo -e "  ${RED}Invalid format. Use YYYY-MM-DD HH:MM (e.g. 2026-09-20 14:30).${RESET}"
        fi
    done

    # ── Step 4: optional job label ────────────────────────────────────────────
    echo ""
    local job_label
    read -rp "  $(echo -e "${BOLD}Job label/description (optional, press Enter to skip): ${RESET}")" job_label
    [[ -z "${job_label}" ]] && job_label="Congen scheduled job"

    # ── Step 5: build self-logging runner script ───────────────────────────────
    mkdir -p "${SCHEDULE_JOBS_DIR}"
    local job_ts
    job_ts="$(date '+%Y%m%d_%H%M%S')"
    local runner="${SCHEDULE_JOBS_DIR}/job_${job_ts}.sh"

    # Build pipe-separated command name list for the record
    local cmd_list_str
    cmd_list_str="$(IFS='|'; echo "${sel_names[*]}")"

    {
        echo "#!/usr/bin/env bash"
        echo "# Congen Scheduled Job"
        echo "# Label     : ${job_label}"
        echo "# Scheduled : ${run_datetime}"
        echo "# Created   : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# Commands  : ${cmd_list_str}"
        echo ""
        echo "LOG_FILE='${LOG_FILE}'"
        echo "JOB_LABEL='${job_label}'"
        echo ""
        echo "ts() { date '+%Y-%m-%d %H:%M:%S'; }"
        echo ""
        echo "{"
        echo "  echo '========================================'"
        echo "  echo '  Congen Scheduled Job — START'"
        echo "  echo \"  Job Label  : ${job_label}\""
        echo "  echo \"  Triggered  : \$(ts)\""
        echo "  echo \"  Commands   : ${cmd_list_str}\""
        echo "  echo '========================================'"
        echo "} >> \"\${LOG_FILE}\""
        echo ""

        local step=1
        for (( si=0; si<${#sel_names[@]}; si++ )); do
            local cname="${sel_names[$si]}"
            local cscript="${sel_scripts[$si]}"
            echo "# ── Step ${step}: ${cname} ────────────────────────────────────────────"
            echo "echo \"[\$(ts)] SCHEDULED RUN START | step=${step} | command='${cname}'\" >> \"\${LOG_FILE}\""
            echo "_start=\$(date +%s)"
            echo "_tmp=\$(mktemp /tmp/congen_sched_XXXXXX.log)"
            echo ""
            echo "set +e"
            echo "if [[ -f '${cscript}' && -x '${cscript}' ]]; then"
            echo "    '${cscript}' 2>&1 | tee \"\${_tmp}\""
            echo "else"
            echo "    bash -c '${cscript}' 2>&1 | tee \"\${_tmp}\""
            echo "fi"
            echo "_ec=\${PIPESTATUS[0]}"
            echo "set -e"
            echo ""
            echo "_end=\$(date +%s)"
            echo "_elapsed=\$(( _end - _start ))"
            echo "_output=\$(cat \"\${_tmp}\"); rm -f \"\${_tmp}\""
            echo ""
            echo "if [[ \${_ec} -eq 0 ]]; then _status='SUCCESS'; else _status='FAILED'; fi"
            echo ""
            echo "{"
            echo "  echo '========================================'"
            echo "  echo '  Congen Run Audit'"
            echo "  echo \"  Timestamp  : \$(ts)\""
            echo "  echo \"  Command    : ${cname}\""
            echo "  echo \"  Script     : ${cscript}\""
            echo "  echo \"  Status     : \${_status}\""
            echo "  echo \"  Exit Code  : \${_ec}\""
            echo "  echo \"  Duration   : \${_elapsed}s\""
            echo "  echo \"  Triggered  : Scheduled Job — ${job_label}\""
            echo "  echo '  ── Output ──────────────────────────────'"
            echo "  if [[ -n \"\${_output}\" ]]; then"
            echo "    echo \"\${_output}\" | sed 's/^/  | /'"
            echo "  else"
            echo "    echo '  | (no output produced)'"
            echo "  fi"
            echo "  echo '========================================'"
            echo "} >> \"\${LOG_FILE}\""
            echo ""
            (( step++ ))
        done

        echo "{"
        echo "  echo '========================================'"
        echo "  echo '  Congen Scheduled Job — COMPLETE'"
        echo "  echo \"  Job Label  : ${job_label}\""
        echo "  echo \"  Finished   : \$(ts)\""
        echo "  echo '========================================'"
        echo "} >> \"\${LOG_FILE}\""
    } > "${runner}"
    chmod +x "${runner}"

    # ── Step 6: submit to scheduler ───────────────────────────────────────────
    echo ""
    echo -e "  ${DIM}Submitting job to ${backend}…${RESET}"

    local job_id=""
    set +e
    if [[ "${backend}" == "at" ]]; then
        # 'at' takes time then date: e.g.  at 14:30 2026-09-20
        local at_time at_date
        at_time="${run_datetime##* }"   # HH:MM
        at_date="${run_datetime%% *}"   # YYYY-MM-DD

        # Capture 'at' job number from stderr
        local at_stderr
        at_stderr=$(echo "bash '${runner}'" | at "${at_time}" "${at_date}" 2>&1)
        local at_ec=$?
        job_id=$(echo "${at_stderr}" | grep -oP 'job \K[0-9]+' | head -1)
        [[ -z "${job_id}" ]] && job_id="at-$(date +%s)"
        if [[ ${at_ec} -ne 0 ]]; then
            echo -e "  ${RED}${BOLD}✘  'at' submission failed:${RESET}"
            echo "${at_stderr}"
            set -e
            press_enter; return
        fi

    elif [[ "${backend}" == "systemd-run" ]]; then
        # systemd-run --on-calendar accepts systemd time spec
        # Convert "YYYY-MM-DD HH:MM" → "YYYY-MM-DD HH:MM:SS"
        local sd_time="${run_datetime}:00"
        local sd_out
        sd_out=$(systemd-run --user \
                     --on-calendar="${sd_time}" \
                     --unit="congen-job-${job_ts}" \
                     bash "${runner}" 2>&1)
        local sd_ec=$?
        job_id="congen-job-${job_ts}"
        if [[ ${sd_ec} -ne 0 ]]; then
            echo -e "  ${RED}${BOLD}✘  systemd-run submission failed:${RESET}"
            echo "${sd_out}"
            set -e
            press_enter; return
        fi
    fi
    set -e

    # ── Step 7: record the job ────────────────────────────────────────────────
    schedule_record "${job_id}" "${run_datetime}" "${runner}" \
                    "${cmd_list_str}" "${backend}"

    log_entry "SCHEDULED | job_id='${job_id}' | backend='${backend}' | time='${run_datetime}' | commands='${cmd_list_str}' | label='${job_label}'"
    {
        echo "========================================"
        echo "  Congen Schedule Summary"
        echo "  Created    : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "  Job ID     : ${job_id}"
        echo "  Backend    : ${backend}"
        echo "  Run At     : ${run_datetime}"
        echo "  Label      : ${job_label}"
        echo "  Commands   : ${cmd_list_str}"
        echo "  Runner     : ${runner}"
        echo "========================================"
    } >> "${LOG_FILE}"

    # ── Step 8: confirmation screen ───────────────────────────────────────────
    echo ""
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo -e "  ${GREEN}${BOLD}✔  Job successfully scheduled!${RESET}"
    echo ""
    echo -e "  ${BOLD}Job ID         :${RESET} ${YELLOW}${job_id}${RESET}"
    echo -e "  ${BOLD}Backend        :${RESET} ${backend}"
    echo -e "  ${BOLD}Run At         :${RESET} ${run_datetime}"
    echo -e "  ${BOLD}Label          :${RESET} ${job_label}"
    echo -e "  ${BOLD}Commands (seq) :${RESET}"
    local sn=1
    for n in "${sel_names[@]}"; do
        printf "     ${CYAN}%d.${RESET} %s\n" "${sn}" "${n}"
        (( sn++ ))
    done
    echo ""
    echo -e "  ${BOLD}Runner Script  :${RESET} ${DIM}${runner}${RESET}"
    echo -e "  ${BOLD}Schedule Log   :${RESET} ${DIM}${SCHEDULE_FILE}${RESET}"
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo ""
    press_enter
}

