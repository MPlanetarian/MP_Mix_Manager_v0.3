# ---------------------------------------------------------------------------
# Strict mode
# ---------------------------------------------------------------------------
set -euo pipefail

# ---------------------------------------------------------------------------
# Paths & Files
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
MANUAL_FILE="${SCRIPT_DIR}/Congen_Commands_List.txt"
LOG_FILE="${SCRIPT_DIR}/Congen.log"

# KDE Connect run-commands config file (JSON)
KDECONNECT_CFG_DIR="${HOME}/.config/kdeconnect"
KDECONNECT_CMD_FILE="${KDECONNECT_CFG_DIR}/kdeconnectd.json"   # legacy path
# Modern path used by kdeconnect-kde ≥ 21.x
KDECONNECT_PLUGIN_DIR="${KDECONNECT_CFG_DIR}"

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'
WHITE='\033[1;37m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
log_entry() {
    # Append a timestamped entry to the log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${LOG_FILE}"
}

hr() {
    # Print a horizontal rule using the supplied character (default ─)
    local char="${1:-─}"
    local cols
    cols=$(tput cols 2>/dev/null || echo 72)
    printf '%*s\n' "${cols}" '' | tr ' ' "${char}"
}

press_enter() {
    echo ""
    read -rp "$(echo -e "${DIM}  Press [Enter] to continue…${RESET}")" _
}

# ---------------------------------------------------------------------------
# Count currently registered KDE Connect run-commands
# ---------------------------------------------------------------------------
count_kdeconnect_commands() {
    python3 - "${KDECONNECT_CFG_DIR}" <<'PYEOF'
import sys, os, glob, re, json
kdir = sys.argv[1]
total = 0
for cfg in glob.glob(f"{kdir}/*/kdeconnect_runcommand/config"):
    dev_names = set()
    try:
        with open(cfg, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()
        for line in lines:
            line = line.strip()
            if line.startswith("commands="):
                raw = line[len("commands="):].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if raw.startswith("@ByteArray(") and raw.endswith(")"):
                    raw = raw[len("@ByteArray("):-1].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if r'\"' in raw:
                    raw = raw.replace(r'\"', '"')
                try:
                    data = json.loads(raw)
                    if isinstance(data, str): data = json.loads(data)
                    if isinstance(data, dict):
                        for u, entry in data.items():
                            if isinstance(entry, dict) and "name" in entry:
                                dev_names.add(entry["name"])
                except Exception:
                    pass
                break
        in_commands = False
        for line in lines:
            line = line.strip()
            if line == "[commands]": in_commands = True; continue
            if in_commands and line.startswith("["): in_commands = False; continue
            if in_commands and "=" in line:
                k, v = line.split("=", 1)
                if re.match(r'^cmd[0-9]+\\name$', k.strip()):
                    dev_names.add(v.strip())
    except Exception:
        pass
    total += len(dev_names)
print(total)
PYEOF
}

# ---------------------------------------------------------------------------
# Check KDE Connect service status
# ---------------------------------------------------------------------------
check_kdeconnect_status() {
    # Returns: "enabled" | "disabled"
    # Strategy (in order of reliability):
    #   1. systemd user unit kdeconnect (Plasma 6)
    #   2. pgrep for kdeconnectd
    #   3. dbus activation check

    if systemctl --user is-active --quiet kdeconnect.service 2>/dev/null; then
        echo "enabled"
        return
    fi

    if pgrep -x "kdeconnectd" > /dev/null 2>&1; then
        echo "enabled"
        return
    fi

    # Check via D-Bus (works even without systemd unit)
    if dbus-send --session --print-reply \
            --dest=org.freedesktop.DBus \
            /org/freedesktop/DBus \
            org.freedesktop.DBus.ListNames 2>/dev/null \
        | grep -q "org.kde.kdeconnect"; then
        echo "enabled"
        return
    fi

    echo "disabled"
}

# ---------------------------------------------------------------------------
# Check network status (LAN / WiFi)
# ---------------------------------------------------------------------------
check_network_status() {
    # Returns: "up <iface> (<type>)" | "down"
    # Strategy:
    #   1. nmcli (NetworkManager) — most reliable on modern desktops
    #   2. ip link / ip addr     — universal fallback
    #   3. /sys/class/net        — last-resort fallback

    # --- NetworkManager path ---
    if command -v nmcli &>/dev/null; then
        local nm_out
        nm_out=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null) || true
        while IFS=':' read -r dev type state _conn; do
            if [[ "${state}" == "connected" ]]; then
                case "${type}" in
                    ethernet)  echo "up ${dev} (Ethernet)"; return ;;
                    wifi)      echo "up ${dev} (Wi-Fi)";    return ;;
                    *)         echo "up ${dev} (${type})";  return ;;
                esac
            fi
        done <<< "${nm_out}"
    fi

    # --- ip addr fallback ---
    if command -v ip &>/dev/null; then
        while IFS= read -r line; do
            if [[ "${line}" =~ ^[0-9]+:[[:space:]]+([^:]+):[[:space:]]+\<([^>]*)\> ]]; then
                local iface="${BASH_REMATCH[1]}"
                local flags="${BASH_REMATCH[2]}"
                [[ "${iface}" == "lo" ]] && continue
                if [[ "${flags}" == *"UP"* && "${flags}" == *"LOWER_UP"* ]]; then
                    if ip addr show "${iface}" 2>/dev/null | grep -qE 'inet[6]? '; then
                        local type="LAN"
                        [[ "${iface}" =~ ^w ]] && type="Wi-Fi"
                        [[ "${iface}" =~ ^e ]] && type="Ethernet"
                        echo "up ${iface} (${type})"
                        return
                    fi
                fi
            fi
        done < <(ip link show 2>/dev/null)
    fi

    # --- /sys/class/net fallback ---
    for iface_path in /sys/class/net/*; do
        local iface
        iface="$(basename "${iface_path}")"
        [[ "${iface}" == "lo" ]] && continue
        if [[ -f "${iface_path}/operstate" ]] \
           && [[ "$(cat "${iface_path}/operstate")" == "up" ]]; then
            local type="LAN"
            [[ "${iface}" =~ ^w ]] && type="Wi-Fi"
            [[ "${iface}" =~ ^e ]] && type="Ethernet"
            echo "up ${iface} (${type})"
            return
        fi
    done

    echo "down"
}

# ---------------------------------------------------------------------------
# Parse run statistics from Congen.log
# ---------------------------------------------------------------------------
parse_run_stats() {
    # Outputs KEY=VALUE lines consumed by show_banner via eval
    [[ ! -f "${LOG_FILE}" ]] && {
        printf 'STAT_TOTAL_RUNS=0\nSTAT_SUCCESS=0\nSTAT_FAILED=0\n'
        printf 'STAT_LAST_OK_CMD=\x2014\nSTAT_LAST_OK_TIME=\x2014\n'
        printf 'STAT_LAST_FAIL_CMD=\x2014\nSTAT_LAST_FAIL_TIME=\x2014\n'
        return
    }

    python3 - "${LOG_FILE}" <<'PYEOF'
import sys, re, os

log_path = sys.argv[1]
try:
    with open(log_path, 'rb') as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        # Read the tail (last 128KB) for fast parsing
        seek_pos = max(0, size - 131072)
        f.seek(seek_pos)
        content = f.read().decode('utf-8', errors='replace')
except Exception:
    content = ""

blocks = re.split(r'={8,}', content)

total  = 0
ok     = 0
fail   = 0
last_ok_cmd   = '\u2014'
last_ok_time  = '\u2014'
last_fail_cmd  = '\u2014'
last_fail_time = '\u2014'

for block in blocks:
    if 'Congen Run Audit' not in block:
        continue
    sm = re.search(r'Status\s*:\s*(\S+)', block)
    cm = re.search(r'Command\s*:\s*(.+)',   block)
    tm = re.search(r'Timestamp\s*:\s*(.+)', block)
    if not sm:
        continue
    total += 1
    status = sm.group(1).strip()
    cmd    = cm.group(1).strip() if cm else '\u2014'
    ts     = tm.group(1).strip() if tm else '\u2014'
    if status == 'SUCCESS':
        ok += 1
        last_ok_cmd  = cmd
        last_ok_time = ts
    elif 'FAILED' in status:
        fail += 1
        last_fail_cmd  = cmd
        last_fail_time = ts

# safe for eval: wrap values in single quotes, escape any ' inside
def q(s): return "'" + s.replace("'", "'\\''") + "'"

print(f"STAT_TOTAL_RUNS={total}")
print(f"STAT_SUCCESS={ok}")
print(f"STAT_FAILED={fail}")
print(f"STAT_LAST_OK_CMD={q(last_ok_cmd)}")
print(f"STAT_LAST_OK_TIME={q(last_ok_time)}")
print(f"STAT_LAST_FAIL_CMD={q(last_fail_cmd)}")
print(f"STAT_LAST_FAIL_TIME={q(last_fail_time)}")
PYEOF
}

# ---------------------------------------------------------------------------
# Detect any registered KDE Connect command scripts currently running
# ---------------------------------------------------------------------------
get_running_commands() {
    # Prints "name|script" (one per line) for every script currently running.
    # Reads both @ByteArray JSON and legacy [commands] sections.
    local running_raw
    running_raw=$(python3 - "${KDECONNECT_CFG_DIR}" <<'PYEOF'
import sys, os, glob, re, json, subprocess

kdir = sys.argv[1]
seen_cmds = {}
for cfg in glob.glob(f"{kdir}/*/kdeconnect_runcommand/config"):
    try:
        with open(cfg, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()
        for line in lines:
            line = line.strip()
            if line.startswith("commands="):
                raw = line[len("commands="):].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if raw.startswith("@ByteArray(") and raw.endswith(")"):
                    raw = raw[len("@ByteArray("):-1].strip()
                if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
                    raw = raw[1:-1].strip()
                if r'\"' in raw:
                    raw = raw.replace(r'\"', '"')
                try:
                    data = json.loads(raw)
                    if isinstance(data, str): data = json.loads(data)
                    if isinstance(data, dict):
                        for u, entry in data.items():
                            if isinstance(entry, dict):
                                c_name = entry.get("name", "").strip()
                                c_cmd = entry.get("command", "").strip()
                                if c_name and c_cmd: seen_cmds[c_name] = c_cmd
                except Exception:
                    pass
                break
        in_commands = False
        ini_names = {}; ini_cmds = {}
        for line in lines:
            line = line.strip()
            if line == "[commands]": in_commands = True; continue
            if in_commands and line.startswith("["): in_commands = False; continue
            if in_commands and "=" in line:
                k, v = line.split("=", 1)
                k = k.strip(); v = v.strip()
                m_name = re.match(r'^(cmd[0-9]+)\\name$', k)
                m_cmd = re.match(r'^(cmd[0-9]+)\\command$', k)
                if m_name: ini_names[m_name.group(1)] = v
                elif m_cmd: ini_cmds[m_cmd.group(1)] = v
        for k, c_name in ini_names.items():
            if c_name not in seen_cmds and k in ini_cmds:
                seen_cmds[c_name] = ini_cmds[k]
    except Exception:
        pass

for name, script in seen_cmds.items():
    scr_base = os.path.basename(script.split()[0]) if script else ""
    if not scr_base: continue
    res = subprocess.run(["pgrep", "-f", scr_base], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode == 0:
        print(f"{name}|{script}")
PYEOF
)
    if [[ -n "${running_raw}" ]]; then
        echo "${running_raw}"
    fi
}

# ---------------------------------------------------------------------------
# Banner
# ---------------------------------------------------------------------------
show_banner() {
    local status
    status=$(check_kdeconnect_status)

    local total
    total=$(count_kdeconnect_commands)

    local net_raw
    net_raw=$(check_network_status)

    # --- Gather live monitoring data ---
    local stats_raw
    stats_raw=$(parse_run_stats)

    # Eval the KEY=VALUE pairs into local variables safely
    local STAT_TOTAL_RUNS STAT_SUCCESS STAT_FAILED
    local STAT_LAST_OK_CMD STAT_LAST_OK_TIME
    local STAT_LAST_FAIL_CMD STAT_LAST_FAIL_TIME
    eval "${stats_raw}"

    # Detect currently running commands
    local running_raw
    running_raw=$(get_running_commands)

    local run_count=0
    local run_display=""
    if [[ -n "${running_raw}" ]]; then
        local run_names=()
        while IFS='|' read -r rname _; do
            [[ -n "${rname}" ]] && run_names+=("${rname}")
        done <<< "${running_raw}"
        run_count="${#run_names[@]}"
        run_display="${run_names[*]}"          # space-separated list of names
    fi

    # --- KDE Connect service colour/label ---
    local status_color status_label
    if [[ "${status}" == "enabled" ]]; then
        status_color="${GREEN}"
        status_label="● Enabled"
    else
        status_color="${RED}"
        status_label="✗ Disabled"
    fi

    # --- Network colour/label ---
    local net_color net_label
    if [[ "${net_raw}" == down ]]; then
        net_color="${RED}"
        net_label="✗ Down  — No active LAN / Wi-Fi connection detected"
    else
        local net_detail="${net_raw#up }"
        net_color="${GREEN}"
        net_label="● Up    — ${net_detail}"
    fi

    # --- Currently running colour/label ---
    local run_color run_label
    if [[ ${run_count} -gt 0 ]]; then
        run_color="${GREEN}"
        run_label="● ${run_count} active  ›  ${run_display}"
    else
        run_color="${DIM}"
        run_label="○ None"
    fi

    # --- Success/fail ratio colour ---
    local fail_color="${DIM}"
    [[ "${STAT_FAILED}" -gt 0 ]] 2>/dev/null && fail_color="${YELLOW}"

    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        "  ██████╗ ██████╗ ███╗   ██╗ ██████╗ ███████╗███╗   ██╗"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        " ██╔════╝██╔═══██╗████╗  ██║██╔════╝ ██╔════╝████╗  ██║"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        " ██║     ██║   ██║██╔██╗ ██║██║  ███╗█████╗  ██╔██╗ ██║"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        " ██║     ██║   ██║██║╚██╗██║██║   ██║██╔══╝  ██║╚██╗██║"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        " ╚██████╗╚██████╔╝██║ ╚████║╚██████╔╝███████╗██║ ╚████║"
    printf "${CYAN}║${RESET}   ${BOLD}${MAGENTA}%s${RESET}\n" \
        "  ╚═════╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝"
    echo -e "${CYAN}║${RESET}"
    echo -e "${CYAN}║${RESET}   ${BOLD}${WHITE}KDE Connect Commands Generator${RESET}  ${DIM}v1.0.0${RESET}"
    echo -e "${CYAN}║${RESET}"

    # ── System status block ────────────────────────────────────────────────
    echo -e "${CYAN}║${RESET}   ${BOLD}Service Status    :${RESET} ${status_color}${BOLD}${status_label}${RESET}"
    echo -e "${CYAN}║${RESET}   ${BOLD}Network Status    :${RESET} ${net_color}${BOLD}${net_label}${RESET}"
    echo -e "${CYAN}║${RESET}   ${BOLD}Commands Installed:${RESET} ${YELLOW}${BOLD}${total}${RESET}"
    echo -e "${CYAN}║${RESET}"

    # ── Live Monitor block ─────────────────────────────────────────────────
    echo -e "${CYAN}║${RESET}   ${BOLD}${CYAN}── Live Monitor ────────────────────────────────────────────${RESET}"
    echo -e "${CYAN}║${RESET}"

    # Currently running
    printf "${CYAN}║${RESET}   ${BOLD}%-20s${RESET}" "Active Runs     :"
    echo -e " ${run_color}${BOLD}${run_label}${RESET}"

    # Run stats line
    printf "${CYAN}║${RESET}   ${BOLD}%-20s${RESET}" "Total Runs      :"
    if [[ "${STAT_TOTAL_RUNS}" -eq 0 ]] 2>/dev/null; then
        echo -e " ${DIM}No runs recorded yet${RESET}"
    else
        printf " ${WHITE}${BOLD}%s${RESET}  " "${STAT_TOTAL_RUNS}"
        printf "${DIM}│${RESET}  ${GREEN}✔ Success: ${BOLD}%s${RESET}  " "${STAT_SUCCESS}"
        printf "${DIM}│${RESET}  ${fail_color}✘ Failed: ${BOLD}%s${RESET}\n" "${STAT_FAILED}"
    fi

    # Last successful run
    printf "${CYAN}║${RESET}   ${BOLD}%-20s${RESET}" "Last Success    :"
    if [[ "${STAT_LAST_OK_CMD}" == "—" ]]; then
        echo -e " ${DIM}None recorded${RESET}"
    else
        echo -e " ${GREEN}${BOLD}${STAT_LAST_OK_CMD}${RESET}  ${DIM}@ ${STAT_LAST_OK_TIME}${RESET}"
    fi

    # Last failed run
    printf "${CYAN}║${RESET}   ${BOLD}%-20s${RESET}" "Last Failure    :"
    if [[ "${STAT_LAST_FAIL_CMD}" == "—" ]]; then
        echo -e " ${DIM}None recorded${RESET}"
    else
        echo -e " ${RED}${BOLD}${STAT_LAST_FAIL_CMD}${RESET}  ${DIM}@ ${STAT_LAST_FAIL_TIME}${RESET}"
    fi

    echo -e "${CYAN}║${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    # ── Warnings ───────────────────────────────────────────────────────────
    if [[ "${status}" == "disabled" ]]; then
        echo -e "  ${RED}${BOLD}⚠  WARNING:${RESET} KDE Connect service is ${RED}not running${RESET}."
        echo -e "  ${DIM}  Commands will be registered but won't be reachable by devices${RESET}"
        echo -e "  ${DIM}  until the service is started.${RESET}"
        echo ""
        echo -e "  ${YELLOW}  Tip:${RESET} Start the service with:"
        echo -e "  ${DIM}    systemctl --user start kdeconnect.service${RESET}"
        echo -e "  ${DIM}  or by opening the KDE Connect application.${RESET}"
        echo ""
    fi

    if [[ "${net_raw}" == "down" ]]; then
        echo -e "  ${RED}${BOLD}⚠  WARNING:${RESET} No active LAN or Wi-Fi connection detected."
        echo -e "  ${DIM}  KDE Connect requires a local network connection to discover and${RESET}"
        echo -e "  ${DIM}  communicate with paired devices. Commands cannot be sent or${RESET}"
        echo -e "  ${DIM}  received until a network connection is established.${RESET}"
        echo ""
        echo -e "  ${YELLOW}  Action Required:${RESET}"
        echo -e "  ${DIM}    • Connect to a LAN via an Ethernet cable, or${RESET}"
        echo -e "  ${DIM}    • Enable your Wi-Fi and connect to your local network.${RESET}"
        echo -e "  ${DIM}  Note: KDE Connect will NOT work over mobile data or external VPNs${RESET}"
        echo -e "  ${DIM}  — both your PC and phone must be on the same LAN.${RESET}"
        echo ""
    fi

    # ── Active-run alert (shown below warnings so it's impossible to miss) ─
    if [[ ${run_count} -gt 0 ]]; then
        echo -e "  ${GREEN}${BOLD}▶  ${run_count} command(s) currently executing:${RESET}"
        while IFS='|' read -r rname rscript; do
            [[ -z "${rname}" ]] && continue
            echo -e "     ${GREEN}●${RESET} ${BOLD}${rname}${RESET}  ${DIM}→ ${rscript}${RESET}"
        done <<< "${running_raw}"
        echo ""
    fi
}

# ---------------------------------------------------------------------------
# Locate the run-commands plugin config for a specific device, or pick one
# ---------------------------------------------------------------------------
pick_device_config_dir() {
    local -a device_dirs=()
    while IFS= read -r -d '' d; do
        local bname="$(basename "${d}")"
        if [[ -f "${d}/config" && "${bname}" != "backups" && ! "${bname}" =~ ^kdeconnect_ ]]; then
            device_dirs+=("$d")
        fi
    done < <(find "${KDECONNECT_CFG_DIR}" -mindepth 1 -maxdepth 1 \
                  -type d -not -name "." -print0 2>/dev/null)

    if [[ ${#device_dirs[@]} -eq 0 ]]; then
        echo -e "\n  ${RED}No paired KDE Connect devices found.${RESET}" >&2
        echo -e "  ${DIM}Pair a device first using the KDE Connect app, then re-run Congen.${RESET}" >&2
        echo "" >&2
        return 1
    fi

    echo "" >&2
    echo -e "  ${BOLD}${CYAN}Paired Devices:${RESET}" >&2
    echo "" >&2

    local i=1
    local -a names=()
    for dir in "${device_dirs[@]}"; do
        local dev_id
        dev_id="$(basename "${dir}")"
        local name_file="${dir}/config"
        local dev_name="${dev_id}"
        if [[ -f "${name_file}" ]]; then
            dev_name=$(grep -i '^name=' "${name_file}" 2>/dev/null \
                       | head -1 | cut -d'=' -f2- || echo "${dev_id}")
        fi
        names+=("${dev_name}")
        printf "    ${YELLOW}[%d]${RESET} %s  ${DIM}(ID: %s)${RESET}\n" \
               "${i}" "${dev_name}" "${dev_id}" >&2
        (( i++ ))
    done
    if [[ ${#device_dirs[@]} -gt 1 ]]; then
        printf "    ${YELLOW}[a]${RESET} %s\n" "${BOLD}All Paired Devices (${#device_dirs[@]})${RESET}" >&2
    fi

    echo "" >&2
    local choice
    while true; do
        read -rp "  Select device [1-${#device_dirs[@]}${CYAN}/a${RESET}]: " choice
        if [[ "${choice,,}" == "a" || "${choice,,}" == "all" ]]; then
            echo "ALL"
            return 0
        fi
        if [[ "${choice}" =~ ^[0-9]+$ ]] \
           && (( choice >= 1 && choice <= ${#device_dirs[@]} )); then
            break
        fi
        echo -e "  ${RED}Invalid selection.${RESET} Please enter a number between 1 and ${#device_dirs[@]} or 'a' for all." >&2
    done

    local selected_dir="${device_dirs[$(( choice - 1 ))]}"
    local plugin_dir="${selected_dir}/kdeconnect_runcommand"
    mkdir -p "${plugin_dir}"
    echo "${plugin_dir}"
}

get_all_paired_device_plugin_dirs() {
    while IFS= read -r -d '' d; do
        local bname="$(basename "${d}")"
        if [[ -f "${d}/config" && "${bname}" != "backups" && ! "${bname}" =~ ^kdeconnect_ ]]; then
            echo "${d}/kdeconnect_runcommand"
        fi
    done < <(find "${KDECONNECT_CFG_DIR}" -mindepth 1 -maxdepth 1 \
                  -type d -not -name "." -print0 2>/dev/null)
}

# ---------------------------------------------------------------------------
# Read the existing commands section from a KDE-style INI config
# Returns an associative-array-ready string: key=value pairs
# ---------------------------------------------------------------------------
read_commands_from_config() {
    local cfg="$1"
    [[ -f "${cfg}" ]] || return 0
    # Print the [commands] block lines
    awk '/^\[commands\]/{found=1; next} found && /^\[/{found=0} found{print}' \
        "${cfg}" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Write / update a command entry in the plugin config INI
# ---------------------------------------------------------------------------
write_command_to_config() {
    local cfg="$1"     # full path to plugin "config" file
    local key="$2"     # e.g. "cmd0"
    local name="$3"
    local script="$4"

    mkdir -p "$(dirname "${cfg}")"

    # Ensure config file exists
    [[ ! -f "${cfg}" ]] && touch "${cfg}"

    python3 - "${cfg}" "${key}" "${name}" "${script}" <<'PYEOF'
import sys, os, re, json, uuid

cfg_path, key, name, script = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
clean_script = script.replace("\r", "").replace("\n", "").strip()

lines = []
if os.path.isfile(cfg_path):
    try:
        with open(cfg_path, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()
    except Exception:
        lines = []

# -------------------------------------------------------------------
# 1. Update or Initialize the modern @ByteArray JSON payload
# -------------------------------------------------------------------
json_dict = {}
commands_line_idx = -1

for idx, line in enumerate(lines):
    l_strip = line.strip()
    if l_strip.startswith("commands="):
        commands_line_idx = idx
        raw = l_strip[len("commands="):].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if raw.startswith("@ByteArray(") and raw.endswith(")"):
            raw = raw[len("@ByteArray("):-1].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if r'\"' in raw:
            raw = raw.replace(r'\"', '"')
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, str):
                parsed = json.loads(parsed)
            if isinstance(parsed, dict):
                json_dict = parsed
        except Exception:
            pass
        break

# Match existing command by name to update, or create a new UUID entry
found_uuid = None
for u, entry in json_dict.items():
    if isinstance(entry, dict) and entry.get("name") == name:
        found_uuid = u
        break

if not found_uuid:
    found_uuid = str(uuid.uuid4()).replace("-", "_")

json_dict[found_uuid] = {
    "name": name,
    "command": clean_script
}

compact_json = json.dumps(json_dict, separators=(',', ':'))
escaped_json = compact_json.replace('"', '\\"')
new_bytearray_line = f'commands="@ByteArray({escaped_json})"\n'

has_general = any(l.strip() == "[General]" for l in lines)

if commands_line_idx != -1:
    lines[commands_line_idx] = new_bytearray_line
    if not has_general:
        lines.insert(commands_line_idx, "[General]\n")
else:
    if not has_general:
        lines.insert(0, "[General]\n")
        lines.insert(1, new_bytearray_line)
    else:
        gen_idx = next(i for i, l in enumerate(lines) if l.strip() == "[General]")
        lines.insert(gen_idx + 1, new_bytearray_line)

# -------------------------------------------------------------------
# 2. Update the legacy INI [commands] section
# -------------------------------------------------------------------
has_commands_section = any(l.strip() == "[commands]" for l in lines)
if not has_commands_section:
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    lines.append("\n[commands]\n")

name_pattern = re.compile(rf"^{re.escape(key)}\\name=.*$")
cmd_pattern = re.compile(rf"^{re.escape(key)}\\command=.*$")

name_written = False
cmd_written = False

for idx, line in enumerate(lines):
    if name_pattern.match(line.strip()):
        lines[idx] = f"{key}\\name={name}\n"
        name_written = True
    elif cmd_pattern.match(line.strip()):
        lines[idx] = f"{key}\\command={clean_script}\n"
        cmd_written = True

if not name_written or not cmd_written:
    cmd_sec_idx = -1
    for idx, line in enumerate(lines):
        if line.strip() == "[commands]":
            cmd_sec_idx = idx
            break

    insert_pos = len(lines) if cmd_sec_idx == -1 else cmd_sec_idx + 1
    if not name_written:
        lines.insert(insert_pos, f"{key}\\name={name}\n")
        insert_pos += 1
    if not cmd_written:
        lines.insert(insert_pos, f"{key}\\command={clean_script}\n")

with open(cfg_path, "w", encoding="utf-8") as f:
    f.writelines(lines)
PYEOF
}

# ---------------------------------------------------------------------------
# Generate a unique command key (cmd0, cmd1, …) not already in the config
# ---------------------------------------------------------------------------
next_command_key() {
    local cfg="$1"
    local i=0
    while grep -q "^cmd${i}\\\\name=" "${cfg}" 2>/dev/null; do
        (( i++ ))
    done
    echo "cmd${i}"
}

# ---------------------------------------------------------------------------
# Update the manual (Congen_Commands_List.txt)
# ---------------------------------------------------------------------------
update_manual() {
    local cmd_name="$1"
    local script_path="$2"
    local summary="$3"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    # Create or refresh header only when file doesn't exist
    if [[ ! -f "${MANUAL_FILE}" ]]; then
        cat > "${MANUAL_FILE}" <<HEADER
================================================================================
  Congen - KDE Connect Commands List
  Generated by Congen v1.0.0
================================================================================
  This file tracks all KDE Connect run-commands created via Congen.
  Each entry shows:
    • Command Name  : The label shown in the KDE Connect app
    • Script Path   : Full path to the Bash script executed
    • Summary       : Brief description of what the command does
    • Added         : Date/time the command was registered
================================================================================

HEADER
    fi

    # Append the new entry
    cat >> "${MANUAL_FILE}" <<ENTRY
────────────────────────────────────────────────────────────────────────────────
  Command Name : ${cmd_name}
  Script Path  : ${script_path}
  Summary      : ${summary}
  Added        : ${timestamp}
────────────────────────────────────────────────────────────────────────────────

ENTRY
}

