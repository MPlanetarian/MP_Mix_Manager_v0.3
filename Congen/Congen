    fi
    echo ""
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo ""

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # 5 ── AUTO-OPEN all generated files
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    if command -v xdg-open &>/dev/null; then
        echo -e "  ${BOLD}Opening files with default applications…${RESET}"
        echo ""

        # Open TXT
        xdg-open "${txt_file}"  >/dev/null 2>&1 &
        echo -e "    ${GREEN}▶${RESET}  TXT  opened"
        sleep 0.4

        # Open HTML
        xdg-open "${html_file}" >/dev/null 2>&1 &
        echo -e "    ${GREEN}▶${RESET}  HTML opened"
        sleep 0.4

        # Open PDF only if it was generated
        if [[ ${pdf_ok} -eq 1 ]]; then
            xdg-open "${pdf_file}" >/dev/null 2>&1 &
            echo -e "    ${GREEN}▶${RESET}  PDF  opened"
        fi
        echo ""
    else
        echo -e "  ${YELLOW}⚠  xdg-open not found — files saved but not auto-opened.${RESET}"
        echo -e "  ${DIM}  Open the files manually from: ${out_dir}${RESET}"
        echo ""
    fi

    press_enter
}

# ---------------------------------------------------------------------------
# Generate KDE Connect Command from Keyboard Shortcut
# ---------------------------------------------------------------------------
generate_from_shortcut() {
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Generate Command from Keyboard Shortcut${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    # ── Tool detection ────────────────────────────────────────────────────────
    local has_xdotool=0 has_ydotool=0
    command -v xdotool &>/dev/null && has_xdotool=1
    command -v ydotool &>/dev/null && has_ydotool=1

    local session_type="${XDG_SESSION_TYPE:-x11}"

    local tool_str=""
    [[ ${has_xdotool} -eq 1 ]] && tool_str+="${GREEN}● xdotool${RESET}  "
    [[ ${has_ydotool} -eq 1 ]] && tool_str+="${GREEN}● ydotool${RESET}  "
    [[ -z "${tool_str}" ]] && \
        tool_str="${YELLOW}⚠ None installed — script will warn at runtime${RESET}"

    echo -e "  ${BOLD}Session Type  :${RESET}  ${CYAN}${BOLD}${session_type}${RESET}"
    echo -e "  ${BOLD}Key Sim Tools :${RESET}  ${tool_str}"
    echo ""

    if [[ ${has_xdotool} -eq 0 && ${has_ydotool} -eq 0 ]]; then
        echo -e "  ${YELLOW}${BOLD}⚠  No key simulation tool found.${RESET}"
        echo -e "  ${DIM}  The command will be created, but will need a tool installed to run.${RESET}"
        echo -e "  ${DIM}    sudo dnf install xdotool   ${WHITE}# X11 / XWayland${RESET}"
        echo -e "  ${DIM}    sudo dnf install ydotool   ${WHITE}# Wayland native${RESET}"
        echo ""
    fi

    # ── Optional: browse KDE global shortcuts ────────────────────────────────
    echo -e "  ${BOLD}${CYAN}Browse your configured KDE global shortcuts?${RESET}"
    echo -e "  ${DIM}  Reads ~/.config/kglobalshortcutsrc to show your active shortcuts.${RESET}"
    echo ""
    local browse_ans
    read -rp "  $(echo -e "${BOLD}Browse shortcuts first? [y/N]: ${RESET}")" browse_ans

    if [[ "${browse_ans,,}" == "y" ]]; then
        local kgrc="${HOME}/.config/kglobalshortcutsrc"
        echo ""
        if [[ ! -f "${kgrc}" ]]; then
            echo -e "  ${YELLOW}  ~/.config/kglobalshortcutsrc not found.${RESET}"
            echo -e "  ${DIM}  Find your shortcuts at:${RESET}"
            echo -e "  ${DIM}    System Settings → Shortcuts → Global Shortcuts${RESET}"
            echo ""
        else
            echo -e "  ${BOLD}KDE Global Shortcuts (active only):${RESET}"
            echo -e "  ${DIM}$(hr '─')${RESET}"
            python3 - "${kgrc}" <<'PYEOF'
import sys, re, configparser

cfg = configparser.RawConfigParser(strict=False)
cfg.read(sys.argv[1], encoding='utf-8')

rows = []
for section in cfg.sections():
    for key, val in cfg.items(section):
        # Format: shortcut,default_shortcut,friendly_name
        parts = val.split(',')
        shortcut = parts[0].strip()
        friendly = parts[2].strip() if len(parts) >= 3 else key

        # Skip unset shortcuts
        if not shortcut or shortcut.lower() in ('none', ''):
            continue
        # Skip internal KDE markers
        if shortcut.startswith('_'):
            continue

        comp = section[:22]
        rows.append((shortcut, comp, friendly[:44]))

if not rows:
    print("  No active shortcuts found in kglobalshortcutsrc.")
else:
    hdr = f"  {'Shortcut':<30}  {'Component':<24}  Action"
    print(hdr)
    print("  " + "─" * 76)
    for r in sorted(rows, key=lambda x: x[0].lower()):
        print(f"  {r[0]:<30}  {r[1]:<24}  {r[2]}")
PYEOF
            echo -e "  ${DIM}$(hr '─')${RESET}"
            echo ""
            echo -e "  ${DIM}Tip: copy the shortcut exactly as shown above.${RESET}"
        fi
        press_enter
        # Redraw header
        clear
        echo ""
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}Generate Command from Keyboard Shortcut${RESET}"
        echo -e "${CYAN}$(hr '═')${RESET}"
        echo ""
    fi

    # ── Enter shortcut ────────────────────────────────────────────────────────
    echo -e "  ${BOLD}Enter the keyboard shortcut to trigger.${RESET}"
    echo -e "  ${DIM}  Examples : Ctrl+Alt+T  │  Super+L  │  Meta+Shift+S  │  F12  │  Ctrl+F5${RESET}"
    echo -e "  ${DIM}  Modifiers: Ctrl  Alt  Shift  Super (Win key)  Meta  Hyper${RESET}"
    echo ""
    local raw_shortcut
    read -rp "  $(echo -e "${BOLD}Keyboard shortcut: ${RESET}")" raw_shortcut

    if [[ -z "${raw_shortcut}" ]]; then
        echo -e "  ${RED}No shortcut entered. Aborting.${RESET}"
        sleep 1; return
    fi

    # ── Normalise the shortcut using Python3 ──────────────────────────────────
    local norm_shortcut
    norm_shortcut=$(python3 - "${raw_shortcut}" <<'PYEOF'
import sys, re

raw = sys.argv[1].strip()
parts = [p.strip() for p in re.split(r'\s*\+\s*', raw)]

# Map to xdotool-compatible names (also accepted by ydotool ≥ 1.0)
MODS = {
    'ctrl': 'ctrl', 'control': 'ctrl',
    'alt': 'alt', 'option': 'alt',
    'shift': 'shift',
    'super': 'super', 'win': 'super', 'windows': 'super',
    'meta': 'super', 'hyper': 'super',
}
SPECIALS = {
    'return': 'Return', 'enter': 'Return',
    'escape': 'Escape', 'esc': 'Escape',
    'space': 'space', 'spacebar': 'space',
    'backspace': 'BackSpace', 'back': 'BackSpace',
    'tab': 'Tab',
    'delete': 'Delete', 'del': 'Delete',
    'insert': 'Insert', 'ins': 'Insert',
    'home': 'Home', 'end': 'End',
    'pageup': 'Prior', 'page_up': 'Prior', 'pgup': 'Prior',
    'pagedown': 'Next', 'page_down': 'Next', 'pgdn': 'Next',
    'up': 'Up', 'down': 'Down', 'left': 'Left', 'right': 'Right',
    'print': 'Print', 'printscreen': 'Print', 'prtscr': 'Print',
    'pause': 'Pause', 'scrolllock': 'Scroll_Lock',
    'numlock': 'Num_Lock', 'capslock': 'Caps_Lock',
    'plus': 'plus', 'minus': 'minus', 'equal': 'equal',
    'comma': 'comma', 'period': 'period', 'dot': 'period',
    'semicolon': 'semicolon', 'apostrophe': 'apostrophe',
    'slash': 'slash', 'backslash': 'backslash',
    'bracketleft': 'bracketleft', 'bracketright': 'bracketright',
}
FK = re.compile(r'^f(\d{1,2})$', re.IGNORECASE)

out = []
for p in parts:
    pl = p.lower()
    if pl in MODS:
        out.append(MODS[pl])
    elif pl in SPECIALS:
        out.append(SPECIALS[pl])
    elif FK.match(pl):
        out.append(p.upper())          # F1, F12, etc.
    elif len(pl) == 1:
        out.append(pl)                 # single char: t, l, s …
    else:
        out.append(p)                  # unknown — preserve as-is

print('+'.join(out))
PYEOF
)

    echo ""
    echo -e "  ${GREEN}${BOLD}Normalised :${RESET} ${CYAN}${BOLD}${norm_shortcut}${RESET}"
    echo ""

    # ── Command name ──────────────────────────────────────────────────────────
    echo -e "  ${BOLD}Command name${RESET}  ${DIM}(shown in KDE Connect app on your phone)${RESET}"
    local cmd_name
    while true; do
        read -rp "  $(echo -e "${BOLD}Name: ${RESET}")" cmd_name
        [[ -n "${cmd_name}" ]] && break
        echo -e "  ${RED}Name cannot be empty.${RESET}"
    done

    # ── Summary ───────────────────────────────────────────────────────────────
    echo ""
    echo -e "  ${BOLD}Brief summary${RESET}  ${DIM}(what does this shortcut do?)${RESET}"
    local cmd_summary
    read -rp "  $(echo -e "${BOLD}Summary: ${RESET}")" cmd_summary
    [[ -z "${cmd_summary}" ]] && cmd_summary="Triggers keyboard shortcut: ${norm_shortcut}"

    # ── Build & write the bash runner script ──────────────────────────────────
    local shortcut_dir="${SCRIPT_DIR}/KDE_SHORTCUT_SCRIPTS"
    mkdir -p "${shortcut_dir}"

    local safe_name
    safe_name="${cmd_name//[^a-zA-Z0-9_-]/_}"
    local script_path="${shortcut_dir}/${safe_name}.sh"
    local created_ts
    created_ts="$(date '+%Y-%m-%d %H:%M:%S')"

    # Write using printf to avoid heredoc expansion gotchas
    {
        printf '#!/usr/bin/env bash\n'
        printf '# Congen — KDE Connect Keyboard Shortcut Command\n'
        printf '# Name      : %s\n' "${cmd_name}"
        printf '# Shortcut  : %s\n' "${norm_shortcut}"
        printf '# Summary   : %s\n' "${cmd_summary}"
        printf '# Session   : %s\n' "${session_type}"
        printf '# Generated : %s by Congen v1.0.0\n' "${created_ts}"
        printf '#\n'
        printf '# Requires (install one):\n'
        printf '#   sudo dnf install xdotool   # X11 / XWayland\n'
        printf '#   sudo dnf install ydotool   # Wayland native\n'
        printf '\n'
        printf 'SHORTCUT="%s"\n' "${norm_shortcut}"
        printf '\n'
        printf '# Brief pause so KDE Connect finishes its own IPC before keys are injected\n'
        printf 'sleep 0.25\n'
        printf '\n'
        printf 'SESSION="${XDG_SESSION_TYPE:-x11}"\n'
        printf '\n'
        printf 'if [[ "${SESSION}" == "wayland" ]]; then\n'
        printf '    # Native Wayland: ydotool\n'
        printf '    if command -v ydotool &>/dev/null; then\n'
        printf '        ydotool key "${SHORTCUT}" && exit 0\n'
        printf '    fi\n'
        printf '    # Fallback: xdotool via XWayland (works for many KDE Plasma apps)\n'
        printf '    if command -v xdotool &>/dev/null; then\n'
        printf '        DISPLAY="${DISPLAY:-:0}" xdotool key "${SHORTCUT}" && exit 0\n'
        printf '    fi\n'
        printf '    echo "Error: install ydotool (Wayland) or xdotool (XWayland) to run this command." >&2\n'
        printf '    exit 1\n'
        printf 'else\n'
        printf '    # X11 session\n'
        printf '    if command -v xdotool &>/dev/null; then\n'
        printf '        xdotool key "${SHORTCUT}" && exit 0\n'
        printf '    fi\n'
        printf '    if command -v ydotool &>/dev/null; then\n'
        printf '        ydotool key "${SHORTCUT}" && exit 0\n'
        printf '    fi\n'
        printf '    echo "Error: install xdotool to run this command." >&2\n'
        printf '    exit 1\n'
        printf 'fi\n'
    } > "${script_path}"
    chmod +x "${script_path}"

    # ── Pick device and register ──────────────────────────────────────────────
    echo ""
    echo -e "  ${BOLD}${CYAN}Select KDE Connect device to register this command on:${RESET}"
    local plugin_dir
    plugin_dir=$(pick_device_config_dir) || {
        echo -e "  ${RED}No paired device found. Aborting.${RESET}"
        press_enter; return
    }

    local qdbus_bin=""
    if command -v qdbus6 &>/dev/null; then
        qdbus_bin="qdbus6"
    elif command -v qdbus &>/dev/null; then
        qdbus_bin="qdbus"
    fi

    local -a target_plugin_dirs=()
    local -a target_dev_names=()
    local -a target_dev_ids=()

    if [[ "${plugin_dir}" == "ALL" ]]; then
        while IFS= read -r pdir; do
            [[ -n "${pdir}" ]] || continue
            target_plugin_dirs+=("${pdir}")
            local did="$(basename "$(dirname "${pdir}")")"
            target_dev_ids+=("${did}")
            local dname="${did}"
            local dcfg="$(dirname "${pdir}")/config"
            if [[ -f "${dcfg}" ]]; then
                dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
            fi
            target_dev_names+=("${dname}")
        done < <(get_all_paired_device_plugin_dirs)
    else
        target_plugin_dirs+=("${plugin_dir}")
        local did="$(basename "$(dirname "${plugin_dir}")")"
        target_dev_ids+=("${did}")
        local dname="${did}"
        local dcfg="$(dirname "${plugin_dir}")/config"
        if [[ -f "${dcfg}" ]]; then
            dname=$(grep -i '^name=' "${dcfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${did}")
        fi
        target_dev_names+=("${dname}")
    fi

    local last_key="cmd0"
    for (( ti=0; ti<${#target_plugin_dirs[@]}; ti++ )); do
        local t_pdir="${target_plugin_dirs[$ti]}"
        local t_dname="${target_dev_names[$ti]}"
        local t_did="${target_dev_ids[$ti]}"
        mkdir -p "${t_pdir}"
        local t_cfg="${t_pdir}/config"
        local t_key
        t_key=$(next_command_key "${t_cfg}") || true
        [[ -z "${t_key}" ]] && t_key="cmd0"
        last_key="${t_key}"
        write_command_to_config "${t_cfg}" "${t_key}" "${cmd_name}" "${script_path}"
        log_entry "SHORTCUT CMD | name='${cmd_name}' | shortcut='${norm_shortcut}' | session='${session_type}' | script='${script_path}' | key='${t_key}'"
        if [[ -n "${qdbus_bin}" && -n "${t_did}" ]]; then
            "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${t_did}/runcommand" \
                org.kde.kdeconnect.device.runcommand.reload &>/dev/null || true
            "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${t_did}" \
                org.kde.kdeconnect.device.reloadPlugins &>/dev/null || true
        fi
    done

    update_manual "${cmd_name}" "${script_path}" "${cmd_summary}"

    if [[ -n "${qdbus_bin}" ]]; then
        "${qdbus_bin}" org.kde.kdeconnect /modules/kdeconnect \
            org.kde.kdeconnect.daemon.refreshDiscovery 2>/dev/null || true
    fi

    local disp_device
    if [[ "${plugin_dir}" == "ALL" ]]; then
        disp_device="All Paired Devices (${#target_plugin_dirs[@]})"
    else
        disp_device="${target_dev_names[0]}"
    fi

    # ── Final summary screen ──────────────────────────────────────────────────
    clear
    echo ""
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${GREEN}${BOLD}✔  Shortcut Command Created & Installed!${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""
    echo -e "  ${BOLD}Command Name   :${RESET}  ${YELLOW}${BOLD}${cmd_name}${RESET}"
    echo -e "  ${BOLD}Shortcut       :${RESET}  ${CYAN}${BOLD}${norm_shortcut}${RESET}"
    echo -e "  ${BOLD}Summary        :${RESET}  ${cmd_summary}"
    echo -e "  ${BOLD}Session Type   :${RESET}  ${session_type}"
    echo -e "  ${BOLD}Registered To  :${RESET}  ${disp_device}"
    echo -e "  ${BOLD}Config Key     :${RESET}  ${last_key}"
    echo ""
    echo -e "${CYAN}$(hr '─')${RESET}"
    echo -e "  ${BOLD}Script         :${RESET}"
    echo -e "  ${DIM}  ${script_path}${RESET}"
    echo ""
    echo -e "  ${BOLD}How it works:${RESET}"
    printf  "  ${DIM}  1. Open KDE Connect on your phone and tap  '${cmd_name}'${RESET}\n"
    printf  "  ${DIM}  2. KDE Connect runs: %s${RESET}\n" "${safe_name}.sh"
    printf  "  ${DIM}  3. Script simulates pressing: ${CYAN}%s${RESET}\n" "${norm_shortcut}"
    echo -e "  ${DIM}  4. The shortcut action fires on your desktop in real time${RESET}"
    echo ""

    if [[ ${has_xdotool} -eq 0 && ${has_ydotool} -eq 0 ]]; then
        echo -e "  ${YELLOW}${BOLD}⚠  Install a key simulation tool before using this command:${RESET}"
        echo -e "  ${DIM}    sudo dnf install xdotool   ${WHITE}# recommended${RESET}"
        echo -e "  ${DIM}    sudo dnf install ydotool   ${WHITE}# Wayland native${RESET}"
        echo ""
    fi

    echo -e "${CYAN}$(hr '─')${RESET}"
    echo -e "  ${GREEN}✔${RESET}  ${DIM}Congen_Commands_List.txt updated${RESET}"
    echo -e "  ${GREEN}✔${RESET}  ${DIM}Congen.log updated${RESET}"
    echo -e "  ${GREEN}✔${RESET}  ${DIM}KDE Connect daemon notified${RESET}"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""
    press_enter
}

# ---------------------------------------------------------------------------
# Main menu
# ---------------------------------------------------------------------------
main_menu() {
    while true; do
        show_banner

        echo -e "  ${BOLD}Main Menu${RESET}"
        echo ""
        echo -e "    ${YELLOW}[1]${RESET}  Create new KDE Connect command"
        echo -e "    ${YELLOW}[2]${RESET}  View installed KDE Connect commands  ${DIM}(+ remove)${RESET}"
        echo -e "    ${YELLOW}[3]${RESET}  Run a KDE Connect command"
        echo -e "    ${YELLOW}[4]${RESET}  Schedule Congen Commands              ${DIM}(future / sequential)${RESET}"
        echo -e "    ${YELLOW}[5]${RESET}  View Congen Log                       ${DIM}(Congen.log)${RESET}"
        echo -e "    ${YELLOW}[6]${RESET}  Congen Management                     ${DIM}(export / import)${RESET}"
        echo -e "    ${YELLOW}[7]${RESET}  Generate Congen Commands Manual (Multi)"
        echo -e "    ${YELLOW}[8]${RESET}  Congen Alerts                         ${DIM}(sound notifications)${RESET}"
        echo -e "    ${YELLOW}[9]${RESET}  Generate Command from Keyboard Shortcut"
        echo -e "    ${YELLOW}[q]${RESET}  Quit"
        echo ""

        read -rp "  $(echo -e "${BOLD}Select option: ${RESET}")" opt

        case "${opt,,}" in
            1) create_command ;;
            2) view_installed_commands ;;
            3) run_command_menu ;;
            4) schedule_menu ;;
            5) view_log ;;
            6) congen_management ;;
            7) generate_manual ;;
            8) congen_alerts_menu ;;
            9) generate_from_shortcut ;;
            q|quit|exit)
                echo ""
                echo -e "  ${DIM}Goodbye.${RESET}"
                echo ""
                log_entry "Session ended."
                exit 0
                ;;
            *)
                echo -e "\n  ${RED}Invalid option.${RESET} Please select 1–9 or q."
                sleep 1
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
log_entry "Session started. Script: ${BASH_SOURCE[0]}"

# ── Auto-start alert daemon on launch if alerts are enabled ──────────────────
if congen_alerts_is_enabled && ! congen_alerts_is_running; then
    _boot_player=$(congen_alerts_detect_player)
    if [[ "${_boot_player}" != "none" ]]; then
        congen_alerts_start 2>/dev/null || true
    fi
    unset _boot_player
fi

main_menu
