    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""

    # Guard: manual source must exist
    if [[ ! -f "${MANUAL_FILE}" ]]; then
        echo -e "  ${YELLOW}${BOLD}⚠  No commands manual found.${RESET}"
        echo -e "  ${DIM}  ${MANUAL_FILE} does not exist yet.${RESET}"
        echo -e "  ${DIM}  Create at least one command first (option 1).${RESET}"
        echo ""
        press_enter
        return
    fi

    local out_dir="${SCRIPT_DIR}/CONGEN_USER_MANUAL"
    local base_name="Congen_Manual"
    local txt_file="${out_dir}/${base_name}.txt"
    local html_file="${out_dir}/${base_name}.html"
    local pdf_file="${out_dir}/${base_name}.pdf"
    local gen_ts
    gen_ts="$(date '+%Y-%m-%d %H:%M:%S')"

    mkdir -p "${out_dir}"

    echo -e "  ${DIM}Output directory : ${out_dir}${RESET}"
    echo ""

    # ── Count installed commands for the cover ────────────────────────────────
    local total_cmds
    total_cmds=$(count_kdeconnect_commands)

    # ── Parse commands from the manual file using Python ──────────────────────
    local parse_json
    parse_json=$(python3 - "${MANUAL_FILE}" <<'PYEOF'
import sys, re, json

with open(sys.argv[1], 'r', errors='replace') as f:
    content = f.read()

blocks = re.split(r'─{10,}', content)
cmds = []
for block in blocks:
    nm = re.search(r'Command Name\s*:\s*(.+)', block)
    sp = re.search(r'Script Path\s*:\s*(.+)',  block)
    su = re.search(r'Summary\s*:\s*(.+)',      block)
    ad = re.search(r'Added\s*:\s*(.+)',        block)
    if nm:
        cmds.append({
            'name':    nm.group(1).strip(),
            'script':  sp.group(1).strip() if sp else '—',
            'summary': su.group(1).strip() if su else '—',
            'added':   ad.group(1).strip() if ad else '—',
        })
print(json.dumps(cmds))
PYEOF
)

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # 1 ── GENERATE TXT
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    printf "  ${BOLD}[1/3]${RESET} Generating TXT … "

    python3 - "${MANUAL_FILE}" "${txt_file}" "${gen_ts}" "${total_cmds}" \
              "${SCRIPT_DIR}" "${parse_json}" <<'PYEOF'
import sys, json

src, dst, ts, total, sdir, parse_json = \
    sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]

cmds = json.loads(parse_json)
w = '=' * 80

with open(dst, 'w') as f:
    f.write(w + '\n')
    f.write('  CONGEN — KDE Connect Commands Manual\n')
    f.write(f'  Generated : {ts}\n')
    f.write(f'  Script Dir: {sdir}\n')
    f.write(f'  Total Commands: {total}\n')
    f.write(w + '\n\n')

    if not cmds:
        f.write('  No commands recorded yet.\n')
    else:
        for i, c in enumerate(cmds, 1):
            f.write('-' * 80 + '\n')
            f.write(f'  [{i}] {c["name"]}\n')
            f.write('-' * 80 + '\n')
            f.write(f'  Command Name : {c["name"]}\n')
            f.write(f'  Script Path  : {c["script"]}\n')
            f.write(f'  Summary      : {c["summary"]}\n')
            f.write(f'  Date Added   : {c["added"]}\n')
