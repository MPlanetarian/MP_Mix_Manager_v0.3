    echo -e "    ${GREEN}✔${RESET}  ${BOLD}HTML${RESET} → ${DIM}${html_file}${RESET}"
    if [[ ${pdf_ok} -eq 1 ]]; then
        echo -e "    ${GREEN}✔${RESET}  ${BOLD}PDF ${RESET} → ${DIM}${pdf_file}${RESET}  ${DIM}(${pdf_tool})${RESET}"
    else
